generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  email             String              @unique
  password          String?
  usertype          String?
  firstName         String?
  lastName          String?
  gender            String?
  address           String?
  dateOfBirth       DateTime?
  phoneNumber       String?
  dietaryPreference DietaryPreference?
  cartItems         CartItem[]          // Define the relation to CartItem
  orders            Order[]             @relation(name: "UserToOrder") // Define the relation to Order
}

model Log {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  action        String
  email         String
  userId        String  // Explicitly define userId as String
  timestamp     DateTime @default(now())
  orderId       String?  // Add a field to store the PayPal order ID
  amount        Float?   // Add a field to store the payment amount
  currency      String?  // Add a field to store the currency code
  paymentStatus String?  // Add a field to store the payment status (e.g., "captured", "pending", etc.)
}

model DietaryPreference {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @unique
  vegetarian        Boolean @default(false)
  vegan             Boolean @default(false)
  omnivore          Boolean @default(false)
  halal             Boolean @default(false)
  kosher            Boolean @default(false)
  glutenFree        Boolean @default(false)
  lactoseFree       Boolean @default(false)
  nutAllergy        Boolean @default(false)
  otherRestrictions String?
  user              User    @relation(fields: [userId], references: [id])
}

model FoodItem {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  description         String?
  price               Float
  size                String?     // Added size field here
  price25_30          Float?      // For party trays
  price45_50          Float?      // For party trays
  category            String?     // Assuming simple string categories
  dietaryRestrictions String[]    // Array of strings
  imageUrl            String?
  cartItems           CartItem[]  // Define the relation to CartItem
  orderItems          OrderItem[] // Define the relation to OrderItem
  createdAt           DateTime    @default(now())
  deleted             Boolean     @default(false) // New field for soft delete
  @@unique([name, size], name: "name_size") // Ensures uniqueness for combinations of name and size
}

model CartItem {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String
  itemId   String
  quantity Int
  withEgg  Boolean?  // Check if withEgg field is correctly defined
  user     User     @relation(fields: [userId], references: [id])
  foodItem FoodItem @relation(fields: [itemId], references: [id])
}


model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paypalOrderId   String?       // Add this field to store the PayPal order ID
  status          String
  amount          Float
  orderItems      OrderItem[]   // Define the relation to OrderItem
  user            User          @relation(name: "UserToOrder", fields: [userId], references: [id]) // Define the opposite relation to User
  shippingAddress String?       // New fields for shipping information
  contactPerson   String?       // New fields for shipping information
  contactNumber   String?       // New fields for shipping information
  paymentMethod   String?       // New field for payment method (e.g., "PayPal", "COD", etc.)
}

model OrderItem {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId             String
  itemId              String
  itemName            String      // Add field for the name of the item
  itemDescription     String?     // Add field for the description of the item
  itemPrice           Float       // Add field for the price of the item
  itemSize            String?     // Add field for the size of the item
  itemImageUrl        String?     // Add field for the image URL of the item
  quantity            Int
  withEgg             Boolean?    // Ensure withEgg is correctly defined
  totalPrice          Float
  dietaryRestrictions String[]    // Array of strings for dietary restrictions
  order               Order       @relation(fields: [orderId], references: [id])
  foodItem            FoodItem    @relation(fields: [itemId], references: [id])
  createdAt           DateTime    @default(now())
}





model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}
