generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Log {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  action        String
  email         String
  userId        String
  timestamp     DateTime @default(now())
  orderId       String?
  amount        Float?
  currency      String?
  paymentStatus String?
}

model User {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  email             String              @unique
  password          String?
  usertype          String?
  firstName         String?
  lastName          String?
  gender            String?
  address           String?
  dateOfBirth       DateTime?
  phoneNumber       String?
  dietaryPreference DietaryPreference?
  cartItems         CartItem[]          @relation("UserCartItems")
  orders            Order[]             @relation(name: "UserToOrder")
  feedbacks         Feedback[]          @relation("UserFeedbacks")
}

model DietaryPreference {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @unique
  vegetarian        Boolean @default(false)
  vegan             Boolean @default(false)
  omnivore          Boolean @default(false)
  halal             Boolean @default(false)
  kosher            Boolean @default(false)
  glutenFree        Boolean @default(false)
  lactoseFree       Boolean @default(false)
  nutAllergy        Boolean @default(false)
  otherRestrictions String?
  user              User    @relation(fields: [userId], references: [id])
}

model FoodItem {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  description         String?
  price               Float
  size                String?
  price25_30          Float?
  price45_50          Float?
  category            String?
  dietaryRestrictions String[]
  imageUrl            String?
  cartItems           CartItem[]  @relation("FoodItemCartItems")
  orderItems          OrderItem[]
  createdAt           DateTime    @default(now())
  deleted             Boolean     @default(false)
  available           Boolean     @default(true)
  totalPrice          Float?
  size10_12           String?
  size25_30           String?
  size45_50           String?
}

model CartItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  itemId     String
  quantity   Int
  withEgg    Boolean?
  price      Float
  totalPrice Float?
  size10_12  String?
  size25_30  String?
  size45_50  String?
  user       User     @relation(name: "UserCartItems", fields: [userId], references: [id])
  foodItem   FoodItem @relation(name: "FoodItemCartItems", fields: [itemId], references: [id])
}

model Order {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paypalOrderId   String?
  status          String
  amount          Float
  orderItems      OrderItem[]
  user            User          @relation(name: "UserToOrder", fields: [userId], references: [id])
  shippingAddress String?
  contactPerson   String?
  contactNumber   String?
  paymentMethod   String?
  feedbacks       Feedback[]    @relation("OrderFeedbacks")
}

model OrderItem {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId             String
  itemId              String
  itemName            String
  itemDescription     String?
  itemPrice           Float
  itemSize            String?
  itemImageUrl        String?
  quantity            Int
  category            String?
  withEgg             Boolean?
  totalPrice          Float
  dietaryRestrictions String[]
  order               Order       @relation(fields: [orderId], references: [id])
  foodItem            FoodItem    @relation(fields: [itemId], references: [id])
  createdAt           DateTime    @default(now())
  
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String
  userId    String
  rating    Int
  comments  String
  createdAt DateTime @default(now())
  order     Order    @relation(name: "OrderFeedbacks", fields: [orderId], references: [id])
  user      User     @relation(name: "UserFeedbacks", fields: [userId], references: [id])
}


model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}
