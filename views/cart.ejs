  <script>
   document.addEventListener('DOMContentLoaded', function() {
        const modal = $('#dietaryPreferencesModal');
  
        window.openDietaryModal = function() {
          modal.modal('show');
          fetchDietaryPreferencesFields(); // Fetch preferences when opening the modal
        }
  
        window.closeDietaryModal = function() {
          modal.modal('hide');
        }
  
        async function fetchDietaryPreferencesFields() {
          try {
            const response = await fetch('/admin/dietary-preferences');
            if (!response.ok) {
              throw new Error(`HTTP error! Status: ${response.status}`);
            }
            const data = await response.json();
            renderDietaryPreferencesFields(data.preferences);
          } catch (error) {
            console.error("Error fetching dietary preferences fields:", error);
            const errorDisplay = document.getElementById("errorDisplay");
            errorDisplay.textContent = `Error: ${error.message}`;
            errorDisplay.style.display = "block";
          }
        }
  
        function renderDietaryPreferencesFields(preferences) {
          const dynamicFieldsContainer = document.getElementById('dynamicDietaryFields');
          dynamicFieldsContainer.innerHTML = '';
  
          if (!preferences || Object.keys(preferences).length === 0) {
            dynamicFieldsContainer.innerHTML = '<p>No dietary preferences available.</p>';
            return;
          }
  
          Object.keys(preferences).forEach(preference => {
            const fieldHtml = `
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="${preference}" name="${preference}" />
                <label class="form-check-label" for="${preference}">${preference}</label>
              </div>
            `;
            dynamicFieldsContainer.insertAdjacentHTML('beforeend', fieldHtml);
          });
        }
      });
  
      async function handleSubmit(event) {
    event.preventDefault();
    const errorDisplay = document.getElementById("errorDisplay");
    errorDisplay.style.display = "none";
    errorDisplay.textContent = "";
  
    const form = document.getElementById("dietaryForm");
    const formData = new FormData(form);
    const dietaryPreferences = Object.fromEntries(formData.entries());
  
    // Convert form data into a proper boolean object
    for (let key in dietaryPreferences) {
      dietaryPreferences[key] = dietaryPreferences[key] === "on";
    }
  
    // Check if at least one dietary choice is selected
    const isAnyChoiceSelected = Object.values(dietaryPreferences).some(choice => choice);
    if (!isAnyChoiceSelected) {
      errorDisplay.textContent = "Please select at least one dietary preference.";
      errorDisplay.style.display = "block";
      return;
    }
  
    try {
      const response = await fetch("/submit-dietary-preferences", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(dietaryPreferences),
      });
  
      if (response.ok) {
        const data = await response.json();
        if (data.success) {
          Swal.fire({
            icon: "success",
            title: "Success!",
            text: data.message,
            showConfirmButton: true,
          }).then(() => {
            // Redirect to the foodMenu page with an anchor to "Menu Recommendations"
            window.location.href = "/foodMenu#menu-recommendations";
          });
        } else {
          throw new Error(data.message || "An error occurred.");
        }
      } else {
        throw new Error(`HTTP error! Status: ${response.status}`);
      }
    } catch (error) {
      console.error("Error:", error);
      errorDisplay.textContent = error.message;
      errorDisplay.style.display = "block";
    }
  }
  
  
  
  
  </script>
