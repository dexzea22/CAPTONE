    <script>


        // Function to update the quantity of a cart item
        function updateCartItemQuantity(cartItemId, newQuantity) {
            fetch('/api/cart/updateQuantity', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include', // Important for sessions
                body: JSON.stringify({ cartItemId, quantity: newQuantity }),
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to update item quantity in cart. Please try again.');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        // Call the function to fetch and display cart items again
                        displayCartItems();
                        updateCartCounter(); // Update cart counter immediately after updating the quantity
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'Could not update item quantity in the cart.',
                        });
                    }
                })
                .catch(error => {
                    console.error('Error updating item quantity in cart:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'An unexpected error occurred while updating item quantity in the cart.',
                    });
                });
        }

        function displayCartItems() {
    fetch('/api/cart/items', {
        method: 'GET',
        credentials: 'include', // Important for sessions
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Failed to fetch cart items. Please try again.');
        }
        return response.json();
    })
    .then(data => {
        const cartItemsContainer = document.getElementById('mod-cart-items');
        cartItemsContainer.innerHTML = ''; // Clear previous content

        if (data.length > 0) { // Check if data is not empty
            let totalPrice = 0; // Initialize total price variable

            // Iterate through data in reverse order to display the latest item first
            for (let i = data.length - 1; i >= 0; i--) {
                const item = data[i];
                const itemElement = document.createElement('div');
                itemElement.classList.add('row', 'border-top', 'border-bottom');

                // Remove the "card-" prefix from the item name
                const itemName = item.foodItem.name.replace('card-', '');

                // Calculate the total price for each item
                const itemTotalPrice = parseFloat(item.itemPrice) * item.quantity;
                totalPrice += itemTotalPrice; // Add to the total price

                // Determine if the item is with or without egg
                let eggStatus = '';
                if (item.foodItem.category === 'Solo Meals') {
                    eggStatus = item.withEgg ? 'With Egg' : 'Without Egg';
                }

                // Determine the size for Party Trays
                let sizeDisplay = '';
                if (item.foodItem.category === 'Party Trays') {
                    if (item.size10_12) {
                        sizeDisplay = item.size10_12;
                    } else if (item.size25_30) {
                        sizeDisplay = item.size25_30;
                    } else if (item.size45_50) {
                        sizeDisplay = item.size45_50;
                    }
                }

                // Construct dietary restrictions string
                const dietaryRestrictions = item.foodItem.dietaryRestrictions.length > 0 ? `Dietary Restrictions: ${item.foodItem.dietaryRestrictions.join(', ')}` : '';

                itemElement.innerHTML = `
                    <div><img class="img-fluid" src="${item.foodItem.imageUrl}" alt=""></div>
                    <div class="Itm">
                        <span>${itemName} ${sizeDisplay} ${item.foodItem.category} ${eggStatus}</span><br>
                        <span>Dietary Restrictions: ${item.foodItem.dietaryRestrictions.join(', ')}</span><br>
                        <span>Price: PHP ${item.itemPrice}</span><br>
                        <span>Quantity: 
                            <button class="btn-quantity" data-action="decrease" onclick="updateQuantity('${item.id}', ${item.quantity - 1})">-</button>
                            <span>${item.quantity}</span>
                            <button class="btn-quantity" data-action="increase" onclick="updateQuantity('${item.id}', ${item.quantity + 1})">+</button>
                        </span><br>
                        <span>Total Price: PHP ${itemTotalPrice.toFixed(2)}</span>
                        <button class="btn-delete" onclick="deleteCartItem('${item.id}')">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                        </button>
                    </div>`;

                // Append item element to the beginning of the container
                cartItemsContainer.appendChild(itemElement);
            }

            // Update the total price displayed in the UI
            document.getElementById('total-amount').textContent = totalPrice.toFixed(2);
            document.getElementById('total-amounthidden').textContent = totalPrice.toFixed(2);

            // Check if the total price exceeds the limit
            if (totalPrice > 15000) {
                // Display a warning message
                Swal.fire({
                    icon: 'warning',
                    title: 'Cart Limit Exceeded',
                    text: 'Your cart total has exceeded PHP 15,000. Please remove some items.',
                });
            }
        } else {
            // Display a message if the cart is empty
            cartItemsContainer.innerHTML = '<div>No items in cart</div>';
        }
    })
    .catch(error => {
        console.error('Error fetching cart items:', error);
        // Display an error message or handle it as per your requirement
        const cartItemsContainer = document.getElementById('mod-cart-items');
        cartItemsContainer.innerHTML = '<div>Error fetching cart items. Please try again later.</div>';
    });
}

// Call the function to fetch and display cart items when the page loads
document.addEventListener('DOMContentLoaded', displayCartItems);













        function updateQuantity(cartItemId, newQuantity) {
            // Ensure the quantity is not negative
            if (newQuantity < 0) {
                return;
            }
            updateCartItemQuantity(cartItemId, newQuantity);
        }
        // Function to update the cart counter and item counter
        function updateCartCounter() {
            fetch('/api/cart/items', {
                method: 'GET',
                credentials: 'include', // Important for sessions
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to fetch cart items. Please try again.');
                    }
                    return response.json();
                })
                .then(data => {
                    // Calculate total number of items in the cart
                    const totalItems = data.reduce((total, item) => total + item.quantity, 0);
                    // Update the cart counter and item counter in the UI
                    document.getElementById('cart-counter').textContent = totalItems;
                    document.getElementById('item-counter').textContent = totalItems; // Update item counter
                })
                .catch(error => {
                    console.error('Error fetching cart items:', error);
                    // Display an error message or handle it as per your requirement
                });
        }

        // Call the function to update the cart counter and item counter when the page loads
        document.addEventListener('DOMContentLoaded', updateCartCounter);

        // Function to delete a cart item
        function deleteCartItem(cartItemId) {
            fetch(`/api/cart/delete/${cartItemId}`, {
                method: 'DELETE',
                credentials: 'include', // Important for sessions
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to delete item from cart. Please try again.');
                    }
                    // If deletion is successful, remove the item from the UI
                    const deletedItem = document.getElementById(cartItemId);
                    if (deletedItem) {
                        deletedItem.remove();
                    }
                    // Update the cart counter
                    updateCartCounter();
                    // Check if the cart is empty
                    fetch('/api/cart/items', {
                        method: 'GET',
                        credentials: 'include', // Important for sessions
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Failed to fetch cart items. Please try again.');
                            }
                            return response.json();
                        })
                        .then(data => {
                            // If cart is empty, set the total amount to 0
                            if (data.length === 0) {
                                document.getElementById('total-amount').textContent = '0.00';
                            } else {
                                // Update the total amount
                                updateTotalAmount();
                            }
                        })
                        .catch(error => {
                            console.error('Error fetching cart items:', error);
                            // Display an error message or handle it as per your requirement
                        });
                })
                .catch(error => {
                    console.error('Error deleting item from cart:', error);
                    // Display an error message if deletion fails
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Failed to delete item from cart. Please try again.',
                    });
                });
        }


       // Function to update the total amount displayed in the UI
function updateTotalAmount() {
    fetch('/api/cart/items', {
        method: 'GET',
        credentials: 'include', // Important for sessions
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Failed to fetch cart items. Please try again.');
        }
        return response.json();
    })
    .then(data => {
        // Calculate total amount
        let totalAmount = 0;

        data.forEach(item => {
            let itemPrice = 0;

            if (item.foodItem.category === 'Solo Meals') {
                itemPrice = item.foodItem.price;
                if (item.withEgg) {
                    itemPrice += 5; // Add price for egg if applicable
                }
            } else if (item.foodItem.category === 'Party Trays') {
                if (item.foodItem.size === 'Small') {
                    itemPrice = item.foodItem.price;
                } else if (item.foodItem.size === 'Medium') {
                    itemPrice = item.foodItem.price25_30;
                } else if (item.foodItem.size === 'Large') {
                    itemPrice = item.foodItem.price45_50;
                }
            }

            totalAmount += itemPrice * item.quantity;
        });

        // Update the total amount displayed in the UI
        document.getElementById('total-amount').textContent = totalAmount.toFixed(2);
        document.getElementById('total-amounthidden').textContent = totalAmount.toFixed(2);

        // Check if the total price exceeds the limit
        if (totalAmount > 15000) {
            // Display a warning message
            Swal.fire({
                icon: 'warning',
                title: 'Cart Limit Exceeded',
                text: 'Your cart total has exceeded PHP 15,000. Please remove some items.',
            });
        }
    })
    .catch(error => {
        console.error('Error fetching cart items:', error);
        // Display an error message or handle it as per your requirement
    });
}


