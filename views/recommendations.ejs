              <label class="lbld">Allergies:</label>
             
  
  
              <input type="checkbox" id="nutAllergy" name="nutAllergy" value="true" />
              <label class="lbld" for="nutAllergy">Nut Allergy</label>
  
            </div>
  
            <input type="submit" value="Submit" />
          </form>
          <!-- Removed the confirmationMessage div -->
