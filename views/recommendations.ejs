    <div class="container mt-5 text-center">
        <h1 class="ttl"> Recommendations</h1>
        <p style="font-weight: bold; color: #000000;font-size: 18px;">Dietary Preferences: <%= recommendations.dietaryPreferences %></p>

        <% if (recommendations.menuDescription) { %>
            <h2>Menu Description:</h2>
            <div class="row justify-content-center">
                <% 
                const lines = recommendations.menuDescription.split('\n');
                let currentDietaryRestriction = '';
                let currentItemName = '';
                lines.forEach((line, index) => {
                    if (line.startsWith('Dietary Restrictions:')) {
                        currentDietaryRestriction = line.replace('Dietary Restrictions:', '').trim();
                    } else if (line.includes(':') && !line.trim().startsWith('Price')) {
                        currentItemName = line.split(':')[0].trim();
                    } else if (line.trim().startsWith('Price')) {
                        const price = parseFloat(line.replace('Price: $', '').trim());
                        const description = lines[index - 1].split(':')[1].trim();
                        const imageUrl = lines[index + 1].match(/\(([^)]+)\)/)[1];
                %>
                <div class="col-md-4 col-sm-6 my-3">
                    <div class="card" 
                         id="card-<%= currentItemName.replace(/\s+/g, '-') %>"
                         data-dietary-restrictions="<%= currentDietaryRestriction %>">
                        <img src="<%= imageUrl %>" alt="Food Image" class="card-img-top food-image">
                        <div class="card-body">
                            <h5 class="card-title"><%= currentItemName %></h5>
                            <% if (currentDietaryRestriction) { %>
                                <h6 class="card-subtitle mb-2 text-muted"><%= currentDietaryRestriction %></h6>
                            <% } %>
                            <!-- Add to Cart Form -->
                            <div class="form-group">
                                <label for="quantity-<%= currentItemName.replace(/\s+/g, '-') %>">Quantity:</label>
                                <input type="number" name="quantity" style="width: 45px;" id="quantity-<%= currentItemName.replace(/\s+/g, '-') %>" class="quantity-input" min="1" value="1" data-price="<%= price %>" data-egg-price="5">
                            </div>
                            <div class="form-group form-check d-flex justify-content-center">
                              <input type="checkbox" class="form-check-input " name="withEgg" id="withEgg-<%= currentItemName.replace(/\s+/g, '-') %>">
                              <label for="withEgg-<%= currentItemName.replace(/\s+/g, '-') %>" class="form-check-label">With Egg (₱5)</label>
                          </div>
                          
                            <input type="hidden" name="foodName" value="<%= currentItemName %>">
                            <input type="hidden" name="price" value="<%= price %>">
                            <p>Total Price: ₱<span class="total-price"><%= price.toFixed(2) %></span></p>
                            <button type="button" class="cbtn" onclick="addToCart('card-<%= currentItemName.replace(/\s+/g, '-') %>')"><i class="fas fa-shopping-cart"></i></button>
                        </div>
                    </div>
                </div>
                <%
                    }
                });
                %>
            </div>
        <% } else { %>
            <p>No menu description available.</p>
        <% } %>

