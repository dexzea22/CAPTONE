    <!-- JavaScript for dynamic total price calculation -->
    <script>
        document.addEventListener('DOMContentLoaded', (event) => {
            const quantityInputs = document.querySelectorAll('.quantity-input');

            quantityInputs.forEach(input => {
                const price = parseFloat(input.getAttribute('data-price'));
                const eggPrice = parseFloat(input.getAttribute('data-egg-price'));
                const totalPriceElement = input.closest('.card-body').querySelector('.total-price');
                const withEggCheckbox = input.closest('.card-body').querySelector('.form-check-input');

                // Function to calculate total price
                const calculateTotalPrice = () => {
                    const quantity = parseInt(input.value);
                    const isWithEgg = withEggCheckbox.checked;
                    const totalPrice = (price + (isWithEgg ? eggPrice : 0)) * quantity;
                    totalPriceElement.textContent = totalPrice.toFixed(2);
                };

                // Initialize total price on page load
                calculateTotalPrice();

                // Update total price on input change
                input.addEventListener('input', calculateTotalPrice);
                withEggCheckbox.addEventListener('change', calculateTotalPrice);
            });
        });
    </script>

