<!-- orderStatus.ejs -->

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="website icon" type="png" href="images/maya.png" />
        <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:400,700" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
          integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
        <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
        <link rel="stylesheet" href="stylesheets/menu.css" />
      <link rel="stylesheet" href="stylesheets/index.css">
        <title>OrderStatus</title>
      </head>
      
      
              <body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
                <div class="lblso" style="margin: auto;">
                   <label class="fpu">Order Status</label>
                </div>
            
                <% const filteredOrders = orders.filter(order => order.status !== 'Completed' && order.status !== 'delivered'); %>
            
                <!-- Debugging: Output the filteredOrders array to the console -->
                <script>
                    // Escape the JavaScript code properly
                    var filteredOrders = <%- JSON.stringify(filteredOrders) %>;
                    console.log("Filtered Orders:", filteredOrders);
                    // Sort orders in descending order based on order ID
                    filteredOrders.sort((a, b) => b.id - a.id);
                </script>
            
                <% if (filteredOrders.length > 0) { %>
                    <div class="grid-container">
                        <% filteredOrders.forEach(order => { %>
                            <div class="order-card">
                                <p><strong>Order ID:</strong> <%= order.id %></p>
                                <p><strong>Status:</strong> <strong style="color: red;"><%= order.status %></strong></p>
                                <p><strong>Order Date:</strong> <%= new Date(order.createdAt).toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric' }) %></p>
                                <p><strong>Amount:</strong> <%= order.amount %></p>
                                <p><strong>Shipping Address:</strong> <%= order.shippingAddress %></p>
                                <p><strong>Contact Person:</strong> <%= order.contactPerson %></p>
                                <p><strong>Contact Number:</strong> <%= order.contactNumber %></p>
                                <p><strong>Order Items:</strong></p>
                                <strong>Payment Method:</strong> <%= order.paymentMethod %><br> <!-- Display payment method -->
                                <div class="item-grid">
                                    <% order.orderItems.forEach(item => { %>
                                        <div class="item-card">
                                            <p><b>Item Name:</b> <%= item.itemName %></p>
                                            <p><strong>Item Size:</strong> <%= item.itemSize %></p>
                                            <p><strong>Quantity:</strong> <%= item.quantity %></p>
                                            <p><strong>Price:</strong> <%= item.itemPrice %></p>
                                            <p><strong>Total Price:</strong> <%= item.totalPrice %></p>
                                            <img class="fimg" src="<%= item.itemImageUrl %>" alt="<%= item.itemName %>">
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                <% } else { %>
                    <p>No orders found.</p>
                <% } %>
   

</body>

</html>