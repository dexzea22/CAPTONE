</head>
<body style="background-image: url('images/standard-bg.png');background-size: cover;background-repeat: no-repeat;">
  <div class="menu-toggle">
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
  </div>
  <div>
    <div class="menu">
      <a href="/adminDashboard">Dashboard</a>
      <a href="/adminUserTable">User Table</a>
      <a href="/logs">Logs</a>
      <a href="/adminOrderStatus">Transaction History</a>
      <a href="/adminOrderNotifications">Order Notifications</a>
      <a href="/adminCreateFoodItem">Add Food Item</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="side-menu">
      <a href="/adminDashboard">Dashboard</a>
      <a href="/adminUserTable">User Table</a>
      <a href="/adminOrderStatus">Transaction History</a>
      <a href="/adminOrderNotifications">Order Notifications</a>
      <a href="/adminCreateFoodItem">Add Food Item</a>
      <a href="/logs">Logs</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="main-content">
      
     
        <h1 class="admn">User Table</h1>
        <table class="table" style="background-color: white;">
          <thead class="thead-dark">
          <tr>
            <th>Email</th>
            <th>Password</th>
            <th>User Type</th>
            <th class="action-th">Action</th>
          </tr>
        </thead>
        <tbody id="data">
          <!-- Loop through the records retrieved from MongoDB -->
          <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.password %></td>
            <td><%= user.usertype %></td>
            <td colspan="3">
              <div class="btn-group">
                <a href="#" class="btn btn-primary view-btn" data-id="<%= user.id %>">View</a>
                <a href="#" class="btn btn-warning update-btn" data-id="<%= user.id %>">Edit</a>
                <a href="#" class="btn btn-danger delete-btn" data-email="<%= user.email %>">Delete</a>
                

              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Modal for password input -->
    <div
      class="modal fade"
      id="passwordModal"
      tabindex="-1"
      role="dialog"
      aria-labelledby="passwordModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="passwordModalLabel">
              Account Deletion
            </h5>
            <button
              type="button"
              class="close"
              data-dismiss="modal"
              aria-label="Close"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="passwordInput"
                >Please enter your password to confirm deletion:</label
              >
              <input type="password" class="form-control" id="passwordInput" />
            </div>
            <div class="modal-body">
              <div class="form-group">
                <label for="passwordInput">Please enter your password to confirm deletion:</label>
                <input type="password" class="form-control" id="passwordInput" required placeholder="Enter your password">

              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-primary" id="confirmDeleteBtn">
      Confirm</button>
      <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
      </div>
      </div>
        </div>
      </div>
      <script src="scripts/index.js"></script>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
      <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
      <script>
      
        // Function to redirect to the user detail view
function viewUser(userId) {
    window.location.href = `/viewUser/${userId}`;
}

// Function to redirect to the user edit form
function editUser(userId) {
    window.location.href = `/editUser/${userId}`;
}

// Function to show confirmation for deletion
function confirmDelete(email) {
    // Store the email in a global variable or data attribute for use in modal confirmation
    window.deleteEmail = email;
    $('#passwordModal').modal('show'); // Assuming you have a Bootstrap modal for confirmation
}

      $(document).ready(function() {
    $('.view-btn').on('click', function(e) {
        e.preventDefault();
        const userId = $(this).data('id');
        window.location.href = `/viewUser/${userId}`; // Assumes you have a route to display user details
    });

    $('.update-btn').on('click', function(e) {
        e.preventDefault();
        const userId = $(this).data('id');
        window.location.href = `/editUser/${userId}`; // Route to fetch data and show in form for editing
    });

    $(document).ready(function() {
    $('.delete-btn').on('click', function(e) {
        e.preventDefault();
        const userEmail = $(this).data('email');
        window.deleteEmail = userEmail; // Set the global variable to be accessed later
        $('#passwordModal').modal('show'); // Show confirmation modal
    });

    $('#confirmDeleteBtn').click(function() {
        var password = $('#passwordInput').val();
        if (!password) {
            Swal.fire('Error!', 'Password is required!', 'error');
            return;
        }
        $.ajax({
            url: '/deleteUser',
            type: 'POST',
            data: {
                email: window.deleteEmail,
                adminPassword: password
            },
            success: function(response) {
                if (response.success) {
                    Swal.fire('Deleted!', response.message, 'success').then((result) => {
                        if (result.isConfirmed) {
                            window.location.reload(); // Reload the page to reflect the deletion
                        }
                    });
                } else {
                    Swal.fire('Error!', response.message, 'error');
                }
            },
            error: function(xhr, status, error) {
                // Handle the case where the password verification fails
                Swal.fire('Error!', 'Wrong password entered. Please try again!', 'error');
            }
        });
    });
});
});
      </script>      
</body>
</html>
