<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>USER TABLE</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css"/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:400,700" />
  <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet" />
  <link href="https://fonts.cdnfonts.com/css/kreon" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
  <link rel="stylesheet" href="stylesheets/admin.css" />
  <script src="https://code.jquery.com/jquery-3.5.1.js"></script>

  <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
  <style>
      thead.thead-dark th {
          background-color: #343a40;
          color: #fff;
      }
      html, body {
            height: 100%;
        }
        #sidebar {
            min-height: 100vh; /* Ensures the sidebar extends full height */
        }
  </style>
</head>
<div class="d-flex h-100">
  <!-- Sidebar -->
  <nav id="sidebar" class="bg-dark text-light p-3" style="width: 250px;">
      <div class="text-center mb-4">
          <img src="images/maya.png" alt="Maya Logo" class="img-fluid" style="max-width: 80%;">
      </div>
      <ul class="nav flex-column">
          <li class="nav-item">
              <a class="nav-link text-light active" href="/adminDashboard">
                  <i class="fas fa-chart-line"></i> Dashboard
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/adminUserTable">
                  <i class="fas fa-users"></i> User Table
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/logs">
                  <i class="fas fa-clipboard-list"></i> Logs
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/adminTransactionHistory">
                  <i class="fas fa-clock-rotate-left"></i> Transaction History
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/adminOrderNotifications">
                  <i class="fas fa-bell"></i> Order Notifications
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/adminCreateFoodItem">
                  <i class="fas fa-plus"></i> Add Food Item
              </a>
          </li>
          <li class="nav-item">
              <a class="nav-link text-light" href="/logout">
                  <i class="fas fa-right-from-bracket"></i> Logout
              </a>
          </li>
      </ul>
  </nav>

  <!-- Mobile Navbar -->
  <nav class="navbar navbar-expand-md navbar-dark bg-dark d-md-none">
      <a class="navbar-brand" href="#">Admin Dashboard</a>
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
              <li class="nav-item">
                  <a class="nav-link" href="/adminDashboard"><i class="fas fa-chart-line"></i> Dashboard</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/adminUserTable"><i class="fas fa-users"></i> User Table</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/logs"><i class="fas fa-clipboard-list"></i> Logs</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/adminTransactionHistory"><i class="fas fa-clock-rotate-left"></i> Transaction History</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/adminOrderNotifications"><i class="fas fa-bell"></i> Order Notifications</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/adminCreateFoodItem"><i class="fas fa-plus"></i> Add Food Item</a>
              </li>
              <li class="nav-item">
                  <a class="nav-link" href="/logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
              </li>
          </ul>
      </div>
  </nav>
   <!-- Main content -->
   <div class="flex-fill p-4">
        <h1 class="admn">User Table</h1>
        <table id="userTable" class="table" style="background-color: white;">
          <thead class="thead-dark">
          <tr>
            <th>Email</th>
            <th>User Type</th>
            <th class="action-th">Action</th>
          </tr>
        </thead>
        <tbody id="data">
          <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.usertype %></td>
            <td colspan="3">
              <div class="btn-group">
                <a href="#" class="btn btn-primary view-btn" data-id="<%= user.id %>">View</a>
                <% if (user.usertype === 'Admin') { %>
                  <a href="/editUser/<%= user.id %>" class="btn btn-warning update-btn" data-id="<%= user.id %>">Edit</a>
                <% } %>
                <a href="#" class="btn btn-danger delete-btn" data-email="<%= user.email %>">Delete</a>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Modal for password input -->
    <div class="modal fade" id="passwordModal" tabindex="-1" role="dialog" aria-labelledby="passwordModalLabel" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="passwordModalLabel">Account Deletion</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label for="passwordInput">Please enter your password to confirm deletion:</label>
              <input type="password" class="form-control" id="passwordInput" required placeholder="Enter your password">
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-primary" id="confirmDeleteBtn">Confirm</button>
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
    <script src="scripts/index.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>
      $(document).ready(function() {
        $('#userTable').DataTable();

        $('.view-btn').on('click', function(e) {
            e.preventDefault();
            const userId = $(this).data('id');
            window.location.href = `/viewUser/${userId}`;
        });

        $('.update-btn').on('click', function(e) {
            e.preventDefault();
            const userId = $(this).data('id');
            window.location.href = `/editUser/${userId}`;
        });

        $('.delete-btn').on('click', function(e) {
            e.preventDefault();
            const userEmail = $(this).data('email');
            window.deleteEmail = userEmail;
            $('#passwordModal').modal('show');
        });

        $('#confirmDeleteBtn').click(function() {
            var password = $('#passwordInput').val();
            if (!password) {
                Swal.fire('Error!', 'Password is required!', 'error');
                return;
            }
            $.ajax({
                url: '/deleteUser',
                type: 'POST',
                data: {
                    email: window.deleteEmail,
                    adminPassword: password
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire('Deleted!', response.message, 'success').then((result) => {
                            if (result.isConfirmed) {
                                window.location.reload();
                            }
                        });
                    } else {
                        Swal.fire('Error!', response.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire('Error!', 'Wrong password entered. Please try again!', 'error');
                }
            });
        });
      });
    </script>      
</body>
</html>
