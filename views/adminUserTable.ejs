<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>USER TABLE</title>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
  <link rel="website icon" type="png" href="images/maya.png">
  <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet">
  <link href="https://fonts.cdnfonts.com/css/kreon" rel="stylesheet">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Rubik:400,700'>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="stylesheets/admin.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="container">
      <div class="sidenav">
        <a href="/adminDashboard">Dashboard</a>
        <a href="/adminUserTable">User Table</a>
        <a href="/logs">Logs</a>
        <a href="/logout">Logout</a>
        <a href="/adminOrderStatus">Order Status</a>
      </div>
        <h1 style="font-family: kreon,open-sans;font-weight: bold;font-size: 50px;color: black;">User Table</h1>
        <table class="table">
          <thead class="thead-dark">
          <tr>
            <th>Email</th>
            <th>Password</th>
            <th>User Type</th>
            <th class="action-th">Action</th>
          </tr>
          </thead>
          <tbody id="data">
          <!-- Loop through the records retrieved from MongoDB -->
          <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.password %></td>
            <td><%= user.usertype %></td>
            <td colspan="3">
              <div class="btn-group">
                <a href="#" class="btn btn-primary view-btn" data-id="<%= user.id %>">View</a>
                <a href="#" class="btn btn-warning update-btn" data-id="<%= user.id %>">Edit</a>
                <a href="#" class="btn btn-danger delete-btn" data-email="<%= user.email %>">Delete</a>
                

              </div>
            </td>
          </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
      
      <!-- Modal for password input -->
      <div class="modal fade" id="passwordModal" tabindex="-1" role="dialog" aria-labelledby="passwordModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="passwordModalLabel">Account Deletion</h5>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
              <div class="form-group">
                <label for="passwordInput">Please enter your password to confirm deletion:</label>
                <input type="password" class="form-control" id="passwordInput">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-primary" id="confirmDeleteBtn">
      Confirm</button>
      <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
      </div>
      </div>
      
        </div>
      </div>
      <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
      <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
      <script>
      
        // Function to redirect to the user detail view
function viewUser(userId) {
    window.location.href = `/viewUser/${userId}`;
}

// Function to redirect to the user edit form
function editUser(userId) {
    window.location.href = `/editUser/${userId}`;
}

// Function to show confirmation for deletion
function confirmDelete(email) {
    // Store the email in a global variable or data attribute for use in modal confirmation
    window.deleteEmail = email;
    $('#passwordModal').modal('show'); // Assuming you have a Bootstrap modal for confirmation
}

      $(document).ready(function() {
    $('.view-btn').on('click', function(e) {
        e.preventDefault();
        const userId = $(this).data('id');
        window.location.href = `/viewUser/${userId}`; // Assumes you have a route to display user details
    });

    $('.update-btn').on('click', function(e) {
        e.preventDefault();
        const userId = $(this).data('id');
        window.location.href = `/editUser/${userId}`; // Route to fetch data and show in form for editing
    });

    $('.delete-btn').on('click', function(e) {
        e.preventDefault();
        deleteEmail = $(this).data('email');
        $('#passwordModal').modal('show'); // Show modal to confirm deletion
    });

    $(document).ready(function() {
    $('#confirmDeleteBtn').click(function() {
        var password = $('#passwordInput').val();
        $.ajax({
            url: '/deleteUser',
            type: 'POST',
            data: {
                email: window.deleteEmail,
                adminPassword: password
            },
            success: function(response) {
                if (response.success) {
                    Swal.fire('Deleted!', response.message, 'success');
                } else {
                    Swal.fire('Error!', response.message, 'error');
                }
            },
            error: function(xhr, status, error) {
                Swal.fire('Error!', 'Server error: ' + error, 'error');
            }
        });
    });
});
});
      </script>      
</body>
</html>