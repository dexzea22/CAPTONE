        border-radius: 8px;
        box-shadow: 0 2px 10px 0 rgba(70, 76, 79, 0.2);
      }
      .container a {
        color: black;
        text-decoration: none;
      }
      .container a:hover {
        color: #eecf44; /* Darker blue on hover */
        text-decoration: none; /* Underline on hover */
      }
      .backgroundSales {
        background-color: #f7ddad;
        border-radius: 10px;
        height: auto;
        width: 100%;
        padding-bottom: 20px;
        padding-top: 20px;
        margin: auto;
      }
      .backgroundSales h1 {
        padding: 25px;
      }
      .tab-content iframe {
        width: 100%;
        height: 480px;
        border: none;
        border-radius: 2px;
        box-shadow: 0 2px 10px 0 rgba(70, 76, 79, 0.2);
      }
      .iframe-container {
        display: flex;
        flex-direction: row;
        justify-content: space-around; /* Adjusts the space between the iframes */
        gap: 20px; /* Optional: adds gap between the iframes */
      }

      .iframe-container iframe {
        background: #ffffff;
        border: none;
        border-radius: 2px;
        box-shadow: 0 2px 10px 0 rgba(70, 76, 79, 0.2);
        width: 45%; /* Adjust width as needed to fit two iframes in a row */
        height: 480px; /* Adjust height as needed */
      }
