async function loadEditDietaryRestrictions(selectedRestrictions = []) {
    try {
        const response = await fetch('/api/all-dietary-restrictions', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }

        const { preferences } = await response.json();
        console.log('Fetched dietary restrictions for edit:', preferences);

        const container = document.getElementById('editDietaryRestrictionsContainer');
        container.innerHTML = ''; // Clear existing content

        // Ensure preferences is an object with key-value pairs
        if (preferences && typeof preferences === 'object') {
            Object.keys(preferences).forEach(key => {
                const normalizedKey = key.toLowerCase();
                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.id = `edit-${normalizedKey}`;
                checkbox.value = key;

                // Check if the current preference is in the selectedRestrictions (case-insensitive match)
                checkbox.checked = selectedRestrictions.some(item => item.toLowerCase() === normalizedKey);

                const label = document.createElement('label');
                label.htmlFor = `edit-${normalizedKey}`;
                label.textContent = key; // Use the original case for display

                const div = document.createElement('div');
                div.className = 'form-group';
                div.appendChild(checkbox);
                div.appendChild(label);

                container.appendChild(div);
            });
        } else {
            console.error('Invalid format for preferences:', preferences);
        }
    } catch (error) {
        console.error('Error fetching dietary restrictions for edit:', error.message);
    }
}









// Function to submit the update form
function submitUpdateForm() {
    const formData = new FormData(document.getElementById("editForm"));
    const id = formData.get("editItemId");

    // Collect selected dietary restrictions
    const dietaryRestrictions = [];
    document.querySelectorAll('#editDietaryRestrictionsContainer input[type="checkbox"]').forEach((checkbox) => {
        if (checkbox.checked) {
            dietaryRestrictions.push(checkbox.value);
        }
    });

    // Append dietary restrictions as a JSON string
    formData.append('dietaryRestrictions', JSON.stringify(dietaryRestrictions));

    // Log form data for debugging
    for (const [key, value] of formData.entries()) {
        console.log(`${key}: ${value}`);
    }

    fetch(`/adminCreateFoodItem/${id}`, {
        method: "PUT",
        body: formData,
    })
    .then((response) => {
        if (!response.ok) {
            throw new Error("Network response was not ok");
        }
        return response.json();
    })
    .then((data) => {
        if (data.success) {
            Swal.fire({
                icon: "success",
                title: "Updated!",
                text: "The food item has been updated.",
                showConfirmButton: false,
                timer: 1500,
            });
            setTimeout(() => {
                location.reload();
            }, 1500);
        } else {
            Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Failed to update the food item.",
            });
        }
    })
    .catch((error) => {
        console.error("Error updating food item:", error);
        Swal.fire({
            icon: "error",
            title: "Oops...",
            text: "Something went wrong!",
        });
    });
}


