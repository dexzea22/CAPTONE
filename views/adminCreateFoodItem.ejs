        // Open dietary preferences modal
        function openDietaryPreferencesModal() {
            $('#dietaryPreferencesModal').modal('show'); // Show Bootstrap modal
            loadExistingPreferences(); // Load preferences when the modal opens
        }

        // Add dietary preference to the list
        function addDietaryPreference() {
            const input = document.getElementById('dietaryPreferenceInput');
