    <script>






// Open dietary preferences modal
function openDietaryPreferencesModal() {
    document.getElementById('dietaryPreferencesModal').style.display = 'flex'; // Show modal
    loadExistingPreferences(); // Load preferences when the modal opens
    loadDietaryRestrictions(); // Load dietary restrictions when the modal opens
}

// Close dietary preferences modal
function closeDietaryPreferencesModal() {
    document.getElementById('dietaryPreferencesModal').style.display = 'none'; // Hide modal
}

// Add dietary preference to the list
function addDietaryPreference() {
    const input = document.getElementById('dietaryPreferenceInput');
    const value = input.value.trim();

    if (value) {
        addPreferenceToList(value);
        input.value = ''; // Clear input field
        updatePreferences(); // Update preferences after addition
    }
}

// Add a preference to the list with edit and delete buttons
function addPreferenceToList(value) {
    const list = document.getElementById('dietaryPreferencesList');
    const listItem = document.createElement('li');
    listItem.textContent = value;

    // Container for buttons
    const buttonContainer = document.createElement('span');
    buttonContainer.classList.add('button-container'); // Apply container styles

    // Add edit button to each preference
    const editButton = document.createElement('button');
    editButton.textContent = 'Edit';
    editButton.classList.add('modal-btn', 'modal-btn-edit'); // Add edit button class
    editButton.onclick = function () {
        const newValue = prompt('Edit your dietary preference:', value);
        if (newValue) {
            listItem.firstChild.textContent = newValue.trim();
            updatePreferences(); // Update preferences after editing
        }
    };

    // Add delete button to each preference
    const deleteButton = document.createElement('button');
    deleteButton.textContent = 'Delete';
    deleteButton.classList.add('modal-btn', 'modal-btn-delete'); // Add delete button class
    deleteButton.onclick = function () {
        list.removeChild(listItem);
        deletePreference(value); // Delete preference from server
    };

    buttonContainer.appendChild(editButton);
    buttonContainer.appendChild(deleteButton);
    listItem.appendChild(buttonContainer);
    list.appendChild(listItem);
}

// Update the JSON object with the current list of preferences
function updatePreferences() {
    const list = document.getElementById('dietaryPreferencesList');
    const preferences = [];

    Array.from(list.children).forEach(item => {
        const preference = item.firstChild.textContent.trim();
        if (preference) {
            preferences.push(preference); // Collect preferences as an array
        }
    });

    // Optionally, display the updated preferences
    console.log('Updated Preferences:', preferences);
}

// Function to send preferences to the server
function savePreferences() {
    const list = document.getElementById('dietaryPreferencesList');
    const preferences = Array.from(list.children).map(item => {
        return item.firstChild.textContent.trim();
    }).filter(preference => preference); // Collect preferences

    const selectedDietaryRestrictions = Array.from(document.querySelectorAll('input[name="dietaryRestrictions"]:checked')).map(checkbox => checkbox.id);

    fetch('/dietary-preferences', { // No need to manually set userId
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ preferences, dietaryRestrictions: selectedDietaryRestrictions }) // Send preferences and restrictions as JSON
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            Swal.fire('Success', 'Preferences saved successfully!', 'success').then(() => {
                window.location.reload(); // Reload the page after successful save
            });
        } else {
            Swal.fire('Error', `Failed to save preferences: ${data.message}`, 'error');
        }
    })
    .catch(error => {
        console.error('Error sending preferences to server:', error);
        Swal.fire('Error', 'An error occurred while saving preferences.', 'error');
    });
}


// Load existing preferences from the server and display them
function loadExistingPreferences() {
    fetch('/dietary-preferences') // No need to manually set userId
        .then(response => response.json())
        .then(data => {
            const preferences = data.preferences || {};
            const list = document.getElementById('dietaryPreferencesList');
            list.innerHTML = ''; // Clear existing list

            Object.keys(preferences).forEach(preference => {
                if (preferences[preference]) {
                    addPreferenceToList(preference);
                }
            });
        })
        .catch(error => {
            console.error('Error fetching existing preferences:', error);
            Swal.fire('Error', 'An error occurred while fetching preferences.', 'error');
        });
}

// Delete a specific dietary preference from the server
function deletePreference(preference) {
    fetch('/dietary-preferences/delete', {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ preference })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Deleted', 'Preference deleted successfully', 'success');
            } else {
                Swal.fire('Error', `Failed to delete preference: ${data.message}`, 'error');
            }
        })
        .catch(error => {
            console.error('Error deleting preference:', error);
            Swal.fire('Error', 'An error occurred while deleting preference.', 'error');
        });
}





      function previewImage() {
        var fileInput = document.getElementById("imageUpload");
        var imagePreview = document.getElementById("imagePreview");

        var file = fileInput.files[0];
        var reader = new FileReader();

        reader.onload = function (e) {
          imagePreview.src = e.target.result;
        };

        reader.readAsDataURL(file);
      }

      function toggleFields() {
      const category = document.getElementById("category").value;
      const soloMealFields = document.getElementById("soloMealFields");
      const partyTrayFields = document.getElementById("partyTrayFields");

      if (category === "Solo Meals") {
        soloMealFields.style.display = "block";
        partyTrayFields.style.display = "none";
      } else if (category === "Party Trays") {
        soloMealFields.style.display = "none";
        partyTrayFields.style.display = "block";
      } else {
        soloMealFields.style.display = "none";
        partyTrayFields.style.display = "none";
      }
    }


    async function loadDietaryRestrictions(selectedRestrictions = []) {
    try {
        const response = await fetch('/api/dietary-restrictions', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
        }

        const { preferences } = await response.json();
        console.log('Fetched data:', preferences);

        const container = document.getElementById('dietaryRestrictionsContainer');
        container.innerHTML = ''; // Clear existing content

        for (const key of Object.keys(preferences)) {
            const normalizedKey = key.toLowerCase();

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.id = normalizedKey;
            checkbox.value = key;

            // Check if the current preference is in the selectedRestrictions (case-insensitive match)
            checkbox.checked = selectedRestrictions.some(item => item.toLowerCase() === normalizedKey);

            const label = document.createElement('label');
            label.htmlFor = normalizedKey;
            label.textContent = key; // Use the original case for display

            const div = document.createElement('div');
            div.className = 'form-group';
            div.appendChild(checkbox);
            div.appendChild(label);

            container.appendChild(div);
        }
    } catch (error) {
        console.error('Error fetching dietary restrictions:', error.message);
    }
}


document.getElementById("addFoodForm").addEventListener("submit", function (event) {
    event.preventDefault();
    const formData = new FormData(event.target);

    // Dynamically handle dietary restrictions
    const dietaryRestrictions = [];
    document.querySelectorAll('#dietaryRestrictionsContainer input[type="checkbox"]').forEach((checkbox) => {
        if (checkbox.checked) {
            dietaryRestrictions.push(checkbox.value); // Use the original value for casing
        }
    });
    formData.append('dietaryRestrictions', dietaryRestrictions.join(','));

    fetch("/adminCreateFoodItem", {
        method: "POST",
        body: formData,
    })
    .then((response) => response.json())
    .then((data) => {
        if (data.success) {
