          <a href="/adminCreateFoodItem">Add Food Item</a>
          <a href="/logs">Logs</a>
          <a href="/logout">Logout</a>
        </div>
    <div class="main-content">
      <h1 class="admn">Manage Food Item</h1>
      <h1 style="margin-top: 50px; font-size: 40px;">Food Items</h1>
      <button onclick="openAddModal()">Add Food Item</button>
      <table class="table" style="background-color: white;">
        <thead>
          <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Size</th>
            <th>Category</th>
            <th>Dietary Restrictions</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% foodItems.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.description %></td>
            <td>$<%= item.price.toFixed(2) %></td>
            <td><%= item.size %></td>
            <td><%= item.category %></td>
            <td><%= item.dietaryRestrictions.join(', ') %></td>
            <td>
              <!-- Pass item details to openEditModal function -->
              <button
                onclick="openEditModal(
                '<%= item.id %>',
                '<%= item.name %>',
                '<%= item.description %>',
                '<%= item.price %>',
                '<%= item.size %>',
                '<%= item.category %>',
                '<%= item.dietaryRestrictions.join(', ') %>'
                )"
              >
                Edit
              </button>
              <button onclick="deleteFoodItem('<%= item.id %>')">Delete</button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <!-- add -->
    <div id="myModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeAddModal()">&times;</span>

        <h2>Add Food Item</h2>
        <form
          id="addFoodForm"
          action="/adminCreateFoodItem/"
          method="POST"
          enctype="multipart/form-data"
          onsubmit="submitAddForm(); return false;"
        >
          <label for="name">Name:</label><br />
          <input type="text" id="name" name="name" required /><br />

          <label for="description">Description:</label><br />
          <textarea id="description" name="description"></textarea><br />

          <label for="price">Price:</label><br />
          <input
            type="number"
            id="price"
            name="price"
            step="0.01"
            required
          /><br />

          <label for="size">Size:</label><br />
          <input type="text" id="size" name="size" /><br />

          <label for="category">Category:</label><br />
          <input type="text" id="category" name="category" /><br />

          <label for="dietaryRestrictions">Dietary Restrictions:</label><br />
          <select id="dietaryRestrictions" name="dietaryRestrictions" required>
            <option value="">Select Restriction:</option>
            <option value="vegetarian">Vegetarian</option>
            <option value="omnivore">Omnivore</option>
            <option value="glutenFree">Gluten Free</option>
            <option value="nutAllergy">Nut Allergy</option></select
          ><br />

          <label for="imageUpload">Upload Image:</label><br />
          <input
            type="file"
            id="imageUpload"
            name="imageUpload"
            accept="image/*"
          /><br />

          <!-- Remove this hidden input field -->
          <!-- <input type="hidden" id="id" name="id" value="" /> -->

          <button type="submit">Add Food Item</button>
        </form>
      </div>
    </div>

    <!-- Edit Food Item Modal -->
    <div id="editModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeEditModal()">&times;</span>
        <h2>Edit Food Item</h2>
        <form id="editForm">
          <!-- Input fields for editing food item -->
          <label for="editName">Name:</label><br />
          <input type="text" id="editName" name="editName" required /><br />

          <label for="editDescription">Description:</label><br />
          <textarea id="editDescription" name="editDescription"></textarea
          ><br />

          <label for="editPrice">Price:</label><br />
          <input
            type="number"
            id="editPrice"
            name="editPrice"
            step="0.01"
            required
          /><br />

          <label for="editSize">Size:</label><br />
          <input type="text" id="editSize" name="editSize" /><br />

          <label for="editCategory">Category:</label><br />
          <input type="text" id="editCategory" name="editCategory" /><br />

          <label for="editDietaryRestrictions">Dietary Restrictions:</label
          ><br />
          <select
            id="editDietaryRestrictions"
            name="editDietaryRestrictions"
            required
          >
            <option value="">Select Restriction:</option>
            <option value="vegetarian">Vegetarian</option>
            <option value="omnivore">Omnivore</option>
            <option value="glutenFree">Gluten Free</option>
            <option value="nutAllergy">Nut Allergy</option></select
          ><br />

          <label for="editImageUpload">Upload Image:</label><br />
          <input
            type="file"
            id="editImageUpload"
            name="editImageUpload"
            accept="image/*"
            required
          /><br />

          <input type="hidden" id="editItemId" name="editItemId" />

          <!-- Submit button -->
          <button type="button" onclick="submitUpdateForm()">
            Save Changes
          </button>
        </form>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <script>
      function previewImage() {
        var fileInput = document.getElementById("imageUpload");
        var imagePreview = document.getElementById("imagePreview");

        var file = fileInput.files[0];
        var reader = new FileReader();

        reader.onload = function (e) {
          imagePreview.src = e.target.result;
        };

        reader.readAsDataURL(file);
      }

      //sweet Alert
      document
        .getElementById("addFoodForm")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          const formData = new FormData(event.target);
          fetch("/adminCreateFoodItem", {
            method: "POST",
            body: formData,
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.success) {
                const foodItem = data.foodItem;
                Swal.fire({
                  icon: "success",
                  title: "Food Item Created!",
                  html: `
                    <div>
                        <p><strong>Name:</strong> ${foodItem.name}</p>
                        <p><strong>Description:</strong> ${
                          foodItem.description
                        }</p>
                        <p><strong>Price:</strong> ${foodItem.price}</p>
                        <p><strong>Size:</strong> ${foodItem.size}</p>
                        <p><strong>Category:</strong> ${foodItem.category}</p>
                        <p><strong>Dietary Restrictions:</strong> ${foodItem.dietaryRestrictions.join(
                          ", "
                        )}</p>
                        <img src="${foodItem.imageUrl}" alt="${
                    foodItem.name
                  }" style="max-width: 200px; max-height: 200px;">
                    </div>
                `,
                  showConfirmButton: false,
                  timer: 5000,
                }).then(() => {
                  // Redirect to admin dashboard or any other page
                  window.location.href = "/adminDashboard";
                });
              } else {
                Swal.fire({
                  icon: "error",
                  title: "Oops...",
                  text: data.message,
                });
              }
            })
            .catch((error) => {
              console.error("Error creating food item:", error);
              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Something went wrong!",
              });
            });
        });
      //end

      //Add
      // Function to open the add modal
      function openAddModal() {
        document.getElementById("myModal").style.display = "block";
      }

      // Function to close the add modal
      function closeAddModal() {
        document.getElementById("myModal").style.display = "none";
      }

