       // Add a preference to the list with edit and delete buttons
function addPreferenceToList(value) {
    const list = document.getElementById('dietaryPreferencesList');
    const listItem = document.createElement('li');
    listItem.className = 'list-group-item d-flex justify-content-between align-items-center';
    listItem.textContent = value;

    // Edit button
    const editButton = document.createElement('button');
    editButton.textContent = 'Edit';
    editButton.className = 'btn btn-warning btn-sm mr-2';
    editButton.onclick = function () {
        // Open the edit modal
        $('#editPreferenceModal').modal('show');

        // Set the current value in the modal's input field
        document.getElementById('editPreferenceInput').value = value;

        // Save changes when the user clicks "Save" in the modal
        document.getElementById('saveEditButton').onclick = function () {
            const newValue = document.getElementById('editPreferenceInput').value.trim();

            if (newValue) {
                listItem.firstChild.textContent = newValue; // Update list item
                updatePreferences(); // Update preferences after editing
                $('#editPreferenceModal').modal('hide'); // Close the modal
                showNotification('Preference updated successfully!');
            } else {
                showNotification('Please enter a valid preference.');
            }
        };
    };

    // Delete button
    const deleteButton = document.createElement('button');
    deleteButton.textContent = 'Delete';
    deleteButton.className = 'btn btn-danger btn-sm';
    deleteButton.onclick = function () {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                // Proceed with deletion
                deletePreference(value)
                    .then(() => {
                        list.removeChild(listItem);
                        showNotification('Your dietary preference has been deleted.');
                    })
                    .catch(() => {
                        showNotification('An error occurred while deleting the preference.');
                    });
            }
        });
    };

    // Button container
    const buttonContainer = document.createElement('span');
    buttonContainer.classList.add('button-container', 'ml-auto');
    buttonContainer.appendChild(editButton);
    buttonContainer.appendChild(deleteButton);
    listItem.appendChild(buttonContainer);
    list.appendChild(listItem);
}


        // Update the JSON object with the current list of preferences
        function updatePreferences() {
            const list = document.getElementById('dietaryPreferencesList');
            const preferences = [];

            Array.from(list.children).forEach(item => {
                const preference = item.firstChild.textContent.trim();
                if (preference) {
                    preferences.push(preference); // Collect preferences as an array
                }
            });

            // Optionally, display the updated preferences
            console.log('Updated Preferences:', preferences);
        }

        // Function to send preferences to the server
        function savePreferences() {
            const list = document.getElementById('dietaryPreferencesList');
            const preferences = Array.from(list.children).map(item => {
                return item.firstChild.textContent.trim();
            }).filter(preference => preference); // Collect preferences

            const selectedDietaryRestrictions = Array.from(document.querySelectorAll('input[name="dietaryRestrictions"]:checked')).map(checkbox => checkbox.id);

            fetch('/dietary-preferences', { // No need to manually set userId
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ preferences, dietaryRestrictions: selectedDietaryRestrictions }) // Send preferences and restrictions as JSON
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Preferences saved successfully!');
                    window.location.reload(); // Reload the page after successful save
                } else {
                    showNotification(`Failed to save preferences: ${data.message}`);
                }
            })
            .catch(error => {
                console.error('Error sending preferences to server:', error);
                showNotification('An error occurred while saving preferences.');
            });
        }

        // Load existing preferences from the server and display them
        function loadExistingPreferences() {
            fetch('/dietary-preferences') // No need to manually set userId
                .then(response => response.json())
                .then(data => {
                    const preferences = data.preferences || {};
                    const list = document.getElementById('dietaryPreferencesList');
                    list.innerHTML = ''; // Clear existing list

                    Object.keys(preferences).forEach(preference => {
                        if (preferences[preference]) {
                            addPreferenceToList(preference);
                        }
                    });
                })
                .catch(error => {
                    console.error('Error fetching existing preferences:', error);
                    showNotification('An error occurred while fetching preferences.');
                });
        }

    // Delete a specific dietary preference from the server
function deletePreference(preference) {
    return fetch('/dietary-preferences/delete', {
        method: 'DELETE',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ preference })
    })
    .then(response => response.json())
    .then(data => {
        if (!data.success) {
            throw new Error(data.message); // Reject promise if deletion fails
        }
    });
}


