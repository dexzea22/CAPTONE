<!-- Food Item Table -->
<table id="foodItemTable" class="table table-bordered table-striped mt-4">
  <thead class="thead-dark">
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Price (Solo Meals/Small 10-12 Pax)</th>
      <th>Price (Meduim 25-30 Pax)</th>
      <th>Price (Large 45-50 Pax)</th>
      <th>Category</th>
      <th>Dietary Restrictions</th>
      <th>Image</th>
      <th>Availability</th>
      <th>Date</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% foodItems.forEach(item => { %>
    <tr>
      <td><%= item.name %></td>
      <td><%= item.description %></td>
      <td>₱<%= item.price.toFixed(2) %><br/><%= item.size10_12 %></td>
      <td>
        <% if (item.category === 'Solo Meals') { %>
          N/A
        <% } else { %>
          ₱<%= item.price25_30 ? item.price25_30.toFixed(2) : '' %><br/><%= item.size25_30 %>
        <% } %>
      </td>
      <td>
        <% if (item.category === 'Solo Meals') { %>
          N/A
        <% } else { %>
          ₱<%= item.price45_50 ? item.price45_50.toFixed(2) : '' %><br/><%= item.size45_50 %>
        <% } %>
      </td>
      <td><%= item.category %></td>
      <td>
        <% if (item.dietaryRestrictions && Array.isArray(item.dietaryRestrictions) && item.dietaryRestrictions.length > 0) { %>
          <%= item.dietaryRestrictions.join(', ') %>
        <% } else { %>
          None
        <% } %>
      </td>
      <td><img src="<%= item.imageUrl %>" alt="Image Preview" style="max-width: 100px; max-height: 100px;"></td>
      <td><%= item.available ? 'Available' : 'Unavailable' %></td>
      <td><%= item.createdAt.toLocaleString() %></td>
      <td>
        <!-- Pass item details to openEditModal function -->
        <button class="btn btn-warning btn-sm mr-2" onclick="openEditModal(
          '<%= item.id %>',
          '<%= item.name %>',
          '<%= item.description %>',
          '<%= item.price %>',
          '<%= item.size %>',
          '<%= item.category %>',
          '<%= item.available %>',
          '<%= item.price25_30 %>',
          '<%= item.price45_50 %>',
          '<%= item.dietaryRestrictions.join(', ') %>',
          '<%= item.imageUrl %>',
          '<%= item.size10_12 %>',
          '<%= item.size25_30 %>',
          '<%= item.size45_50 %>'
        )">
          Edit
        </button>
        <button class="btn btn-danger btn-sm" onclick="deleteFoodItem('<%= item.id %>')">Delete</button>
      </td>
      
    </tr>
    <% }); %>
  </tbody>
</table>
