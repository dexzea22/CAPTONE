              <button onclick="openEditModal(
                '<%= item.id %>',
                '<%= item.name %>',
                '<%= item.description %>',
                '<%= item.price %>',
                '<%= item.size %>',
                '<%= item.category %>',
                '<%= item.available %>',
                '<%= item.price25_30 %>',
                '<%= item.price45_50 %>',
                '<%= item.dietaryRestrictions.join(', ') %>',
                '<%= item.imageUrl %>',
                '<%= item.size10_12 %>',
                '<%= item.size25_30 %>',
                '<%= item.size45_50 %>',
              )">
                Edit
              </button>
              <button onclick="deleteFoodItem('<%= item.id %>')">Delete</button>
            </td>
          </tr>
          <% }); %>
        </tbody>
