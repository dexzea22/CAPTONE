    <style>
      /* Table Header Styling */
thead.thead-dark th {
    background-color: #343a40;
    color: #fff;
}

/* The Modal (background) */
.modal-overlay {
    display: none; /* Hidden by default */
    position: fixed; /* Stay in place */
    z-index: 1; /* Sit on top */
    left: 0;
    top: 0;
    width: 100%; /* Full width */
    height: 100%; /* Full height */
    overflow: auto; /* Enable scroll if needed */
    background-color: rgba(0, 0, 0, 0.4); /* Black with opacity */
}

/* Modal Content/Box */
.modal-content {
    background-color: #fefefe;
    margin: 5% auto; /* Centered */
    padding: 20px;
    border: 1px solid #888;
    width: 80%; /* Adjusted width */
    max-width: 600px; /* Maximum width */
    max-height: 80vh; /* Maximum height to ensure it doesn't exceed viewport height */
    overflow-y: auto; /* Enable vertical scroll if content overflows */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Subtle shadow */
    border-radius: 8px; /* Rounded corners */
    position: relative; /* For positioning close button */
}

/* Close Button */
.modal-close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.modal-close:hover,
.modal-close:focus {
    color: black;
    text-decoration: none;
}

/* Modal Title */
.modal-title {
    color: #333;
    margin-top: 0;
    text-align: center;
}

/* Modal Input and Buttons */
.modal-input {
    width: calc(100% - 22px);
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    margin-bottom: 10px;
}



/* List of Preferences */
.modal-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

/* Button Styling */
.modal-btn {
    background-color: #008CBA; /* Primary color for buttons */
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
    font-size: 16px;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

/* Add Button */
.modal-btn-add {
    background-color: #28a745; /* Green for 'Add' */
}

.modal-btn-add:hover {
    background-color: #218838; /* Darker green on hover */
}

/* Save Preferences Button */
.modal-btn-save {
    background-color: #007bff; /* Blue for 'Save' */
}

.modal-btn-save:hover {
    background-color: #0056b3; /* Darker blue on hover */
}

/* Edit Button (Warning) */
.modal-btn-edit {
    background-color: #FFC107; /* Warning color */
    color: black;
}

.modal-btn-edit:hover {
    background-color: #e0a800; /* Darker warning color on hover */
}

/* Delete Button (Danger) */
.modal-btn-delete {
    background-color: #F44336; /* Danger color */
    color: white;
}

.modal-btn-delete:hover {
    background-color: #c82333; /* Darker danger color on hover */
}

/* Buttons Container */
.button-container {
    display: inline-flex;
    gap: 5px; /* Space between buttons */
}


/* Responsive Table Styling */
@media(max-width: 789px) {
    table {
        width: 100%; /* Full width on smaller screens */
    }
}

  </style>
  
