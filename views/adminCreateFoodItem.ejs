/* Center the modal vertically and horizontally */
.modal-dialog {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100% - 1rem); /* Ensure the modal is always centered */
}

.modal-content {
  background-color: #fefefe;
  padding: 20px;
  border: 1px solid #888;
  width: 80%; /* Adjust width for larger screens */
  max-width: 800px; /* Limit the maximum width */
  border-radius: 8px; /* Rounded corners */
  margin: auto; /* Center horizontally */
  max-height: calc(100vh - 2rem); /* Prevent the modal from exceeding the viewport height */
  overflow-y: auto; /* Enable vertical scrolling if content overflows */
}

/* Header and close button */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #e5e5e5;
  padding-bottom: 10px;
}

.modal-header .close {
  font-size: 28px;
  font-weight: bold;
  color: #aaa;
  cursor: pointer;
}

.modal-header .close:hover,
.modal-header .close:focus {
  color: black;
  text-decoration: none;
  cursor: pointer;
}

/* Modal body */
.modal-body {
  padding: 20px;
}

/* Modal footer */
.modal-footer {
  display: flex;
  justify-content: flex-end;
  border-top: 1px solid #e5e5e5;
  padding-top: 10px;
}

/* Responsive adjustments */
@media screen and (max-width: 768px) {
  .modal-content {
    width: 90%; /* Increase width on smaller screens */
  }
}

@media screen and (max-width: 480px) {
  .modal-content {
    width: 95%; /* Further increase width on the smallest screens */
  }
}

