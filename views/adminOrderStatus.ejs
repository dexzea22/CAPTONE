<!-- jQuery -->
<script type="text/javascript" charset="utf8" src="https://code.jquery.com/jquery-3.5.1.js"></script>
  
<!-- DataTables JS -->
<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>

  <script
    src="https://www.paypal.com/sdk/js?client-id=AVu3WborcTvCGiCezIWmlpoZl8aV3sREwYVeBrZAWl8Dej6WlLIY9mnfD527IwI4a6UbEIvWhlV4p8_o"></script>
</head>

<body style="background-image: url('images/standard-bg.png');background-size: cover;background-repeat: no-repeat;">
  <div class="menu-toggle">
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
  </div>
  <div>
    <div class="menu">
      <a href="/adminDashboard">Dashboard</a>
      <a href="/adminUserTable">User Table</a>
      <a href="/logs">Logs</a>
      <a href="/adminOrderStatus">Transaction History</a>
      <a href="/adminOrderNotifications">Order Notifications</a>
      <a href="/adminCreateFoodItem">Add Food Item</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="side-menu">
      <a href="/adminDashboard">Dashboard</a>
      <a href="/adminUserTable">User Table</a>
      <a href="/adminOrderStatus">Transaction History</a>
      <a href="/adminOrderNotifications">Order Notifications</a>
      <a href="/adminCreateFoodItem">Add Food Item</a>
      <a href="/logs">Logs</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="main-content">
      <h1 class="admn">Transaction History</h1>
      <!-- Instructions for search and filter -->
      <div class="instructions">
        <p>Use the fields below to search by Order ID or filter by status:</p>
      </div>
      <form class="form-inline my-2 my-lg-0" action="/adminOrderStatus" method="GET">
        <input class="form-control mr-sm-2" type="text" placeholder="Enter Order ID" aria-label="Search" name="orderId"
          value="<%= orderId %>">
        <!-- Dropdown for status selection -->
        <select class="form-control mr-sm-2" name="statusTerm">
          <option value="">All Statuses</option>
          <option value="preparing">Preparing</option>
          <option value="cooking">Cooking</option>
          <option value="ready">Ready</option>
          <option value="dispatched">Dispatched</option>
          <option value="delivered">Delivered</option>
        </select>
        <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search/Filter</button>
      </form>
      <table id="ordersTable" class="table table-striped" style="background-color: white;">
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order=> { %>
            <tr>
              <td>
                <%= order.id %>
              </td>
              <td>
                <%= order.status %>
              </td>
              <td>
                <%= new Date(order.createdAt).toLocaleString() %>
              </td>
              <td>
                <button class="btn btn-danger" onclick="deleteOrder('<%= order.id %>')">Delete</button>
              </td>
            </tr>
            <% }); %>
        </tbody>
      </table>


      <script src="scripts/index.js"></script>

      <script>
        function deleteOrder(orderId) {
          Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
          }).then((result) => {
            if (result.isConfirmed) {
              fetch(`/adminOrderStatus/delete/${orderId}`, {
                method: "POST",
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({ orderId: orderId })
              }).then(response => response.json())
                .then(data => {
                  if (data.success) {
                    Swal.fire("Deleted!", "Your file has been deleted.", "success");
                    setTimeout(() => location.reload(), 2000); // Reload after 2 seconds
                  } else {
                    Swal.fire("Failed!", "The item could not be deleted. " + data.message, "error");
                  }
                }).catch(error => {
                  console.error('Error deleting the order:', error);
                  Swal.fire("Error!", "An error occurred while deleting the order.", "error");
                });
            }
          });
        }
        $(document).ready(function () {
          $('#ordersTable').DataTable({
            "order": [[2, "desc"]] // Example of default sorting by the Date column in descending order
          });
        });
      </script>
</body>

</html>