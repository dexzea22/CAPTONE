<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Order Status</title>
    <link rel="website icon" type="png" href="images/maya.png" />
    <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/kreon" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:400,700"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA=="crossorigin="anonymous" referrerpolicy="no-referrer"/>
    <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="stylesheets/admin.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://www.paypal.com/sdk/js?client-id=AVu3WborcTvCGiCezIWmlpoZl8aV3sREwYVeBrZAWl8Dej6WlLIY9mnfD527IwI4a6UbEIvWhlV4p8_o"></script>
  </head>

<body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
    <div class="menu-toggle">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
      </div>
      <div>
        <div class="sidenav">
          <a href="/adminDashboard">Dashboard</a>
          <a href="/adminUserTable">User Table</a>
          <a href="/logs">Logs</a>
          <a href="/logout">Logout</a>
          <a href="/adminOrderStatus">Order Status</a>
        </div>
        <div class="side-menu">
          <a href="/adminDashboard">Dashboard</a>
          <a href="/adminUserTable">User Table</a>
          <a href="/adminOrderStatus">Edit Order Status</a>
  
          <a href="/logs">Logs</a>
          <a href="/logout">Logout</a>
        </div>
    <div >
        <!-- Flash message handling -->
        <% if (typeof successMsg !=='undefined' && successMsg.length> 0) { %>
            <div class="alert alert-success" role="alert">
                <%= successMsg %>
            </div>
            <% } %>

                <% if (typeof errorMsg !=='undefined' && errorMsg.length> 0) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= errorMsg %>
                    </div>
                    <% } %>

                        <div class="main-content">
                            <h1 class="admin">Admin Order Status</h1>
                            <form id="orderStatusForm" action="/adminOrderStatus/update" method="post">
                                <label for="orderId">Order ID:</label>
                                <input type="text" id="orderId" name="orderId" required><br><br>

                                <label for="newStatus">New Status:</label>
                                <select id="newStatus" name="newStatus" required>
                                    <option value="">Select Status</option>
                                    <option value="preparing">Preparing</option>
                                    <option value="cooking">Cooking</option>
                                    <option value="ready">Ready</option>
                                    <option value="dispatched">Dispatched</option>
                                    <option value="delivered">Delivered</option>
                                </select><br><br>

                                <button type="submit">Update Status</button>
                            </form>
                        </div>
    </div>
    <!-- Add your JavaScript code here -->
    <script>
        // Function to validate the form before submission
        function validateForm() {
            const orderId = document.getElementById('orderId').value;
            const newStatus = document.getElementById('newStatus').value;

            // Check if order ID is empty
            if (!orderId.trim()) {
                alert('Please enter a valid order ID.');
                return false;
            }

            // Check if new status is selected
            if (!newStatus) {
                alert('Please select a new status.');
                return false;
            }

            // Form is valid
            return true;
        }

        // Add event listener to form submission
        document.getElementById('orderStatusForm').addEventListener('submit', function (event) {
            // Validate the form before submission
            if (!validateForm()) {
                // Prevent form submission if validation fails
                event.preventDefault();
            }
        });
    </script>
</body>

</html>