<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <title>Analytics Summary</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      .main-content {
        padding: 20px;
        max-width: 1200px;
        margin: auto;
      }
      h1 {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }
      table th,
      table td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      table th {
        background-color: #f4f4f4;
      }
      table tr:nth-child(even) {
        background-color: #f9f9f9;
      }
    </style>
  </head>
  <body>
    <div class="main-content text-center">
      <img
        src="images/maya.png"
        alt="Maya Logo"
        class="img-fluid"
        style="width: 20%; margin-bottom: 20px"
      />
      <h1>Analytics Summary</h1>

      <!-- Dashboard Summary Table -->
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Revenue by Day</th>
            <th>Monthly Revenue</th>
            <th>Yearly Revenue</th>
            <th>Top-Selling Items</th>
          </tr>
        </thead>
        <tbody id="dashboardTableBody">
          <!-- Table rows will be inserted here by the script -->
        </tbody>
      </table>
    </div>

    <script>
      // Fetch and display the data
      async function loadDashboardData() {
        try {
          const [dailyRevenue, monthlyRevenue, yearlyRevenue, topSellingItems] =
            await Promise.all([
              fetch("/api/revenue-by-day").then((res) => res.json()),
              fetch("/api/monthly-revenue").then((res) => res.json()),
              fetch("/api/yearly-revenue").then((res) => res.json()),
              fetch("/api/top-selling-items").then((res) => res.json()),
            ]);

          const tableBody = document.getElementById("dashboardTableBody");

          dailyRevenue.forEach((dayData, index) => {
            const row = document.createElement("tr");

            const dayCell = document.createElement("td");
            dayCell.textContent = dayData.day;
            row.appendChild(dayCell);

            const revenueDayCell = document.createElement("td");
            revenueDayCell.textContent = `₱${dayData.totalRevenue.toFixed(2)}`;
            row.appendChild(revenueDayCell);

            const monthlyRevenueCell = document.createElement("td");
            monthlyRevenueCell.textContent =
              index < monthlyRevenue.length
                ? `₱${monthlyRevenue[index].totalRevenue.toFixed(2)} (${
                    monthlyRevenue[index].month
                  })`
                : "-";
            row.appendChild(monthlyRevenueCell);

            const yearlyRevenueCell = document.createElement("td");
            yearlyRevenueCell.textContent =
              index < yearlyRevenue.length
                ? `$${yearlyRevenue[index].totalRevenue.toFixed(2)} (${
                    yearlyRevenue[index].year
                  })`
                : "-";
            row.appendChild(yearlyRevenueCell);

            const topItemsCell = document.createElement("td");
            topItemsCell.textContent =
              index < topSellingItems.length
                ? `${topSellingItems[index].name}: ₱${topSellingItems[
                    index
                  ].totalSales.toFixed(2)}`
                : "-";
            row.appendChild(topItemsCell);

            tableBody.appendChild(row);
          });
        } catch (error) {
          console.error("Error loading dashboard data:", error);
        }
      }

      loadDashboardData();
    </script>
  </body>
</html>