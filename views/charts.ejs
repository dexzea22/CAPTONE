}
      // Fetch and display the data (same as before)
      async function loadDashboardData() {
        try {
          const [dailyRevenue, monthlyRevenue, yearlyRevenue, topSellingItems] =
            await Promise.all([
              fetch("/api/revenue-by-day").then((res) => res.json()),
              fetch("/api/monthly-revenue").then((res) => res.json()),
              fetch("/api/yearly-revenue").then((res) => res.json()),
              fetch("/api/top-selling-items").then((res) => res.json()),
            ]);

          const dailyTableBody = document.getElementById(
            "dailyRevenueTableBody"
          );
          const monthlyTableBody = document.getElementById(
            "monthlyRevenueTableBody"
          );
          const yearlyTableBody = document.getElementById(
            "yearlyRevenueTableBody"
          );
          const topItemsTableBody = document.getElementById(
            "topSellingItemsTableBody"
          );

          // Populate the Daily Revenue Table
          dailyRevenue.forEach((dayData) => {
            const row = document.createElement("tr");

            // Assuming dayData.day is something like "2024-09-01" (YYYY-MM-DD)
            const dayCell = document.createElement("td");
            const date = new Date(dayData.day);

            if (!isNaN(date.getTime())) {
              // Check if the date is valid
              // Format date as desired, e.g., "September 1, 2024"
              const formattedDate = date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              });
              dayCell.textContent = formattedDate;
            } else {
              // Handle invalid date
              dayCell.textContent = "Invalid Date";
            }

            row.appendChild(dayCell);

            const revenueDayCell = document.createElement("td");
            revenueDayCell.textContent = `₱${dayData.totalRevenue.toFixed(2)}`;
            row.appendChild(revenueDayCell);

            const actionCell = document.createElement("td");
            actionCell.style.textAlign = 'center'; // Center the buttons in the cell
            actionCell.innerHTML = `
                <button class="btn btn-sm btn-info" onclick="downloadRowCSV('daily', '${
                  dayData.day
                }', '${dayData.totalRevenue.toFixed(2)}')">CSV</button>
                <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('daily', '${
                  dayData.day
                }', '${dayData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            dailyTableBody.appendChild(row);
          });

          // Populate the Monthly Revenue Table
          monthlyRevenue.forEach((monthData) => {
            const row = document.createElement("tr");

            const monthCell = document.createElement("td");
            monthCell.textContent = monthData.month;
            row.appendChild(monthCell);

            const revenueMonthCell = document.createElement("td");
            revenueMonthCell.textContent = `₱${monthData.totalRevenue.toFixed(
              2
            )}`;
            row.appendChild(revenueMonthCell);

            const actionCell = document.createElement("td");
            actionCell.style.textAlign = 'center'; // Center the buttons in the cell
            actionCell.innerHTML = `
              <button class="btn btn-sm btn-info" onclick="downloadRowCSV('monthly', '${
                monthData.month
              }', '${monthData.totalRevenue.toFixed(2)}')">CSV</button>
              <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('monthly', '${
                monthData.month
              }', '${monthData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            monthlyTableBody.appendChild(row);
          });

          // Populate the Yearly Revenue Table
          yearlyRevenue.forEach((yearData) => {
            const row = document.createElement("tr");

            const yearCell = document.createElement("td");
            yearCell.textContent = yearData.year;
            row.appendChild(yearCell);

            const revenueYearCell = document.createElement("td");
            revenueYearCell.textContent = `₱${yearData.totalRevenue.toFixed(
              2
            )}`;
            row.appendChild(revenueYearCell);

            const actionCell = document.createElement("td");
            actionCell.style.textAlign = 'center'; // Center the buttons in the cell
            actionCell.innerHTML = `
              <button class="btn btn-sm btn-info" onclick="downloadRowCSV('yearly', '${
                yearData.year
              }', '${yearData.totalRevenue.toFixed(2)}')">CSV</button>
              <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('yearly', '${
                yearData.year
              }', '${yearData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            yearlyTableBody.appendChild(row);
