  // Download table as CSV
function downloadTable(tableId) {
  const table = document.getElementById(tableId);
  let csvContent = "data:text/csv;charset=utf-8,";
  const rows = table.querySelectorAll("tr");

  rows.forEach((row) => {
    const cols = row.querySelectorAll("td, th");
    const rowData = Array.from(cols)
      .map((col) => col.textContent.trim())
      .map((text) => text.replace(/,/g, ';')) // Replace commas to avoid CSV conflicts
      .join(",");
    csvContent += rowData + "\r\n";
  });

  const encodedUri = encodeURI(csvContent);
  const link = document.createElement("a");
  link.setAttribute("href", encodedUri);
  link.setAttribute("download", `${tableId}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

// Download specific row as CSV
function downloadRowCSV(type, label, value) {
  let csvContent = "data:text/csv;charset=utf-8,";

  if (type === "daily") {
    csvContent += "Date,Revenue\n";
    csvContent += `${label},PHP ${value}\n`; // Changed to "PHP"
  } else if (type === "monthly") {
    csvContent += "Month,Revenue\n";
    csvContent += `${label},PHP ${value}\n`; // Changed to "PHP"
  } else if (type === "yearly") {
    csvContent += "Year,Revenue\n";
    csvContent += `${label},PHP ${value}\n`; // Changed to "PHP"
  } else if (type === "topSelling") {
    csvContent += "Item Name,Total Sales\n";
    csvContent += `${label},PHP ${value}\n`; // Changed to "PHP"
  }

  const encodedUri = encodeURI(csvContent);
  const link = document.createElement("a");
  link.setAttribute("href", encodedUri);
  link.setAttribute("download", `${type}-${label}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
}

    // Function to convert an image to Base64 and use it in PDF
function getBase64Image(url, callback) {
  const img = new Image();
  img.crossOrigin = "Anonymous";
  img.onload = function () {
    const canvas = document.createElement("canvas");
    canvas.width = img.width;
    canvas.height = img.height;
    const ctx = canvas.getContext("2d");
    ctx.drawImage(img, 0, 0);
    const dataURL = canvas.toDataURL("image/png");
    callback(dataURL);
  };
  img.src = url;
}

async function downloadRowPDF(type, label, value, trend) {
  // Ensure jsPDF is loaded
  const { jsPDF } = window.jspdf;

  if (!jsPDF) {
    console.error("jsPDF is not loaded.");
    return;
  }

  const doc = new jsPDF({ unit: "mm", format: "a4" });

  // Function to add image with better quality
  function addImageToPDF() {
    getBase64Image("images/maya.png", function (base64Image) {
      const imgWidth = 40; // Width in mm
      const imgHeight = 30; // Height in mm

      // Calculate position to right-align the image
      const pdfWidth = doc.internal.pageSize.getWidth();
      const xPosition = pdfWidth - imgWidth - 10; // 10 mm from the right edge
      const yPosition = 10; // Adjust if needed for better placement

      doc.addImage(base64Image, "PNG", xPosition, yPosition, imgWidth, imgHeight); // Position and size
      addContent();
    });
  }

// Function to add content after image
function addContent() {
  // Add Title and Introduction
  doc.setFontSize(16);
  doc.text("Revenue Report", 10, 50);
  doc.setFontSize(12);
  doc.text(
    "This report provides details on the revenue for the selected item.",
    10,
    60
  );
  doc.text(
    "--------------------------------------------------",
    10,
    65
  );

  // Add Details Based on Type
  doc.setFontSize(14);
  if (type === "daily") {
    doc.text("Daily Revenue Report", 10, 75);
    doc.setFontSize(12);
    doc.text(`Date: ${label}`, 10, 85);
    doc.text(`Revenue: PHP ${value}`, 10, 95); // Changed to "PHP"
  } else if (type === "monthly") {
    doc.text("Monthly Revenue Report", 10, 75);
    doc.setFontSize(12);
    doc.text(`Month: ${label}`, 10, 85);
    doc.text(`Revenue: PHP ${value}`, 10, 95); // Changed to "PHP"
  } else if (type === "yearly") {
    doc.text("Yearly Revenue Report", 10, 75);
    doc.setFontSize(12);
    doc.text(`Year: ${label}`, 10, 85);
    doc.text(`Revenue: PHP ${value}`, 10, 95); // Changed to "PHP"
  } else if (type === "topSelling") {
    doc.text("Top-Selling Item Report", 10, 75);
    doc.setFontSize(12);
    doc.text(`Item Name: ${label}`, 10, 85);
    doc.text(`Total Sales: PHP ${value}`, 10, 95); // Changed to "PHP"
  }

  // Add Trend Analysis with improved description
  doc.setFontSize(12);
  doc.text("Trend Analysis:", 10, 105);
  let trendText;

  if (trend > 0) {
    trendText = `The revenue shows an upward trend, indicating growth compared to the previous period. This positive trend suggests an increase in demand or pricing strategies.`;
  } else if (trend < 0) {
    trendText = `The revenue indicates a downward trend, reflecting a decrease compared to the previous period. This could be due to lower demand, competitive pressures, or seasonal factors.`;
  } else {
    trendText = `The revenue remains stable, showing no significant change compared to the previous period. This stability suggests consistent performance.`;
  }

  doc.text(trendText, 10, 115, { maxWidth: 180 });

  // Add Footer
  doc.setFontSize(10);
  doc.text("Generated by Maya & Me", 10, 250);
  doc.text("Date: " + new Date().toLocaleDateString(), 10, 255);

  // Save the PDF
  doc.save(`${type}-${label}.pdf`);
}


  // Add the image and then the rest of the content
  addImageToPDF();
}

  // Function to download the entire table as a PDF
  function downloadPDF(tableId) {
        const table = document.getElementById(tableId);

        // Use html2pdf to convert table to PDF
        const opt = {
          margin: 1,
          filename: `${tableId}.pdf`,
          image: { type: "jpeg", quality: 0.98 },
          html2canvas: { scale: 2 },
          jsPDF: { unit: "in", format: "letter", orientation: "portrait" },
        };

        html2pdf().from(table).set(opt).save();
      }

// // Initialize and load data
// document.addEventListener("DOMContentLoaded", loadDashboardData);

    </script>
  </body>
</html>
