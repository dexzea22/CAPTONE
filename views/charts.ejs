function initializeDataTables() {
  if ($.fn.DataTable.isDataTable('#dailyRevenueTable')) {
    $('#dailyRevenueTable').DataTable().destroy();
  }
  $('#dailyRevenueTable').DataTable();
  
  if ($.fn.DataTable.isDataTable('#monthlyRevenueTable')) {
