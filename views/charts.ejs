}

/* Container for the tables to center them and handle responsiveness */
.table-container {
  width: 100%;
  max-width: 100%; /* Ensure it doesn’t exceed container width */
  margin: 20px auto; /* Center the table container */
  overflow-x: hidden; /* Hide horizontal scrollbar */
}

/* General Table Styles */
table.revenue-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px; /* Space below each table */
  table-layout: fixed; /* Ensures consistent column width */
}

table.revenue-table thead {
  background-color: #f8f9fa; /* Light background for the header */
}

table.revenue-table th, 
table.revenue-table td {
  padding: 12px 15px; /* Add padding inside the cells */
  border: 1px solid #dee2e6; /* Add border around cells */
  text-align: left; /* Align text to the left */
  word-wrap: break-word; /* Ensures long words break and fit in cells */
}

table.revenue-table th {
  background-color: #343a40; /* Dark background for headers */
  color: white; /* White text for headers */
  font-weight: bold; /* Bold text for headers */
}

table.revenue-table td {
  background-color: #ffffff; /* White background for cells */
}

/* Responsive Styling */
@media (max-width: 768px) {
  table.revenue-table thead {
    display: none; /* Hide header on small screens */
  }

  table.revenue-table tr {
    display: block;
    margin-bottom: 10px; /* Space between rows */
  }

  table.revenue-table td {
    display: block;
    text-align: right;
    padding-left: 50%;
    position: relative;
  }

  table.revenue-table td::before {
    content: attr(data-label);
    position: absolute;
    left: 0;
    width: 45%;
    padding-left: 10px;
    font-weight: bold;
    text-align: left;
  }
}

/* Button Styling */
table.revenue-table .btn {
  margin: 0 5px; /* Space between buttons */
}





