   <!-- Date Picker and Download Button -->
<div class="date-picker-container">
  <label for="startDate" class="form-label">Start Date:</label>
  <input type="date" id="startDate" class="form-control d-inline-block" />
  
  <label for="endDate" class="form-label">End Date:</label>
  <input type="date" id="endDate" class="form-control d-inline-block" />
  
  <button class="btn btn-primary" onclick="downloadPDF()">Download PDF</button>
</div>

    
      <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
      <script>
async function downloadPDF() {
  const startDate = document.getElementById('startDate').value;
  const endDate = document.getElementById('endDate').value;

  if (!startDate || !endDate) {
    alert("Please select both start and end dates.");
    return;
  }

  try {
    // Fetch revenue data based on selected dates
    const response = await fetch(`/api/revenue-by-day?startDate=${startDate}&endDate=${endDate}`);
    const revenueData = await response.json();

    // Generate PDF
    const { jsPDF } = window.jspdf;
    if (!jsPDF) {
      console.error("jsPDF is not loaded.");
      return;
    }

    const doc = new jsPDF({ unit: "mm", format: "a4" });
    
    // Add logo image at the top center
    const logoUrl = 'images/maya.png'; // URL to your image
    const logoImg = await fetch(logoUrl);
    const logoBlob = await logoImg.blob();
    const logoDataUri = URL.createObjectURL(logoBlob);
    
    // Define the dimensions for the logo
    const logoWidth = 40;  // Width of the logo in mm
    const logoHeight = 40; // Height of the logo in mm

    // Calculate center position
    const pdfWidth = doc.internal.pageSize.getWidth();
    const centerX = (pdfWidth - logoWidth) / 2;

    doc.addImage(logoDataUri, 'PNG', centerX, 10, logoWidth, logoHeight, undefined, 'FAST');
    
    doc.setFontSize(16);
    doc.text("Sales Report", 10, 50);
    doc.setFontSize(12);
    doc.text(`Date Range: ${formatDate(startDate)} to ${formatDate(endDate)}`, 10, 60);
    doc.text("--------------------------------------------------", 10, 65);

    // Add revenue data to the PDF in table format
    let yOffset = 75;
    let totalSales = 0;
    const tableColumnWidth = 80;

    // Headers
    doc.setFontSize(12);
    doc.text("Date", 10, yOffset);
    doc.text("Sales", 10 + tableColumnWidth, yOffset);
    doc.text("--------------------------------------------------", 10, yOffset + 5);

    // Add data rows
    revenueData.forEach((data) => {
      yOffset += 10;
      doc.text(formatDate(data.day), 10, yOffset);
      doc.text(`PHP ${data.totalRevenue.toFixed(2)}`, 10 + tableColumnWidth, yOffset);
      totalSales += data.totalRevenue;
    });

    // Add overall total sales
    yOffset += 10;
    doc.text("Overall Total Sales:", 10, yOffset);
    doc.text(`PHP ${totalSales.toFixed(2)}`, 10 + tableColumnWidth, yOffset);

    // Add footer
const footerText = `Generated By Maya & Me\nDate: ${formatDate(new Date().toISOString().split('T')[0])}`;
doc.setFontSize(10);
doc.text(footerText, 190, 290, { align: 'right' });

    // Save the PDF
    doc.save(`sales-report-${formatDate(startDate)}-to-${formatDate(endDate)}.pdf`);

  } catch (error) {
    console.error("Error generating PDF:", error);
  }
}

// Function to format date from YYYY-MM-DD to Month Day, Year
function formatDate(dateString) {
  const options = { year: 'numeric', month: 'long', day: 'numeric' };
  return new Date(dateString).toLocaleDateString('en-US', options);
}



