<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="stylesheets/admin.css" />

    <!-- DataTables CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css"
    />
    <!-- Include jsPDF from a CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>

    <!-- jQuery and DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <title>Analytics Summary</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      .main-content {
        padding: 20px;
        max-width: 1200px;
        margin: auto;
      }
      h1 {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
      }
      h2 {
        font-size: 20px;
        font-weight: bold;
        margin-top: 40px;
        margin-bottom: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }
      table th,
      table td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      table th {
        background-color: #f4f4f4;
      }
      table tr:nth-child(even) {
        background-color: #f9f9f9;
      }
      .download-btn {
        margin-bottom: 20px;
        margin-right: 10px;
      }
    </style>
  </head>
  <body>
    <div class="d-flex h-100">
      <!-- Sidebar -->
      <nav id="sidebar" class="bg-dark text-light p-3" style="width: 250px">
        <div class="text-center mb-4">
          <img
            src="images/maya.png"
            alt="Maya Logo"
            class="img-fluid"
            style="max-width: 80%"
          />
        </div>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link text-light active" href="/adminDashboard">
              <i class="fas fa-chart-line"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/adminUserTable">
              <i class="fas fa-users"></i> User Table
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/logs">
              <i class="fas fa-clipboard-list"></i> Logs
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/adminTransactionHistory">
              <i class="fas fa-clock-rotate-left"></i> Transaction History
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/adminOrderNotifications">
              <i class="fas fa-bell"></i> Order Notifications
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/adminCreateFoodItem">
              <i class="fas fa-plus"></i> Add Food Item
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-light" href="/logout">
              <i class="fas fa-right-from-bracket"></i> Logout
            </a>
          </li>
        </ul>
      </nav>

      <!-- Mobile Navbar -->
      <nav class="navbar navbar-expand-md navbar-dark bg-dark d-md-none">
        <a class="navbar-brand" href="#">Admin Dashboard</a>
        <button
          class="navbar-toggler"
          type="button"
          data-toggle="collapse"
          data-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/adminDashboard"
                ><i class="fas fa-chart-line"></i> Dashboard</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/adminUserTable"
                ><i class="fas fa-users"></i> User Table</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logs"
                ><i class="fas fa-clipboard-list"></i> Logs</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/adminTransactionHistory"
                ><i class="fas fa-clock-rotate-left"></i> Transaction History</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/adminOrderNotifications"
                ><i class="fas fa-bell"></i> Order Notifications</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/adminCreateFoodItem"
                ><i class="fas fa-plus"></i> Add Food Item</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout"
                ><i class="fas fa-right-from-bracket"></i> Logout</a
              >
            </li>
          </ul>
        </div>
      </nav>

      <div class="main-content text-center">
        <img
          src="images/maya.png"
          alt="Maya Logo"
          class="img-fluid"
          style="width: 20%; margin-bottom: 20px"
        />
        <h1>Analytics Summary</h1>

        <!-- Revenue by Day Table -->
        <h2>Revenue by Day</h2>
        <button
          class="btn btn-primary download-btn"
          onclick="downloadTable('dailyRevenueTable')"
        >
          Download Revenue by Day (CSV)
        </button>
        <button
          class="btn btn-secondary download-btn"
          onclick="downloadPDF('dailyRevenueTable')"
        >
          Download Revenue by Day (PDF)
        </button>
        <table id="dailyRevenueTable">
          <thead>
            <tr>
              <th>Date</th>
              <th>Revenue</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="dailyRevenueTableBody">
            <!-- Table rows will be inserted here by the script -->
          </tbody>
        </table>

        <!-- Monthly Revenue Table -->
        <h2>Monthly Revenue</h2>
        <button
          class="btn btn-primary download-btn"
          onclick="downloadTable('monthlyRevenueTable')"
        >
          Download Monthly Revenue (CSV)
        </button>
        <button
          class="btn btn-secondary download-btn"
          onclick="downloadPDF('monthlyRevenueTable')"
        >
          Download Monthly Revenue (PDF)
        </button>
        <table id="monthlyRevenueTable">
          <thead>
            <tr>
              <th>Month</th>
              <th>Revenue</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="monthlyRevenueTableBody">
            <!-- Table rows will be inserted here by the script -->
          </tbody>
        </table>

        <!-- Yearly Revenue Table -->
        <h2>Yearly Revenue</h2>
        <button
          class="btn btn-primary download-btn"
          onclick="downloadTable('yearlyRevenueTable')"
        >
          Download Yearly Revenue (CSV)
        </button>
        <button
          class="btn btn-secondary download-btn"
          onclick="downloadPDF('yearlyRevenueTable')"
        >
          Download Yearly Revenue (PDF)
        </button>
        <table id="yearlyRevenueTable">
          <thead>
            <tr>
              <th>Year</th>
              <th>Revenue</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="yearlyRevenueTableBody">
            <!-- Table rows will be inserted here by the script -->
          </tbody>
        </table>

        <!-- Top-Selling Items Table -->
        <h2>Top-Selling Items</h2>
        <button
          class="btn btn-primary download-btn"
          onclick="downloadTable('topSellingItemsTable')"
        >
          Download Top-Selling Items (CSV)
        </button>
        <button
          class="btn btn-secondary download-btn"
          onclick="downloadPDF('topSellingItemsTable')"
        >
          Download Top-Selling Items (PDF)
        </button>
        <table id="topSellingItemsTable">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Total Sales</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="topSellingItemsTableBody">
            <!-- Table rows will be inserted here by the script -->
          </tbody>
        </table>
      </div>
    </div>
    <script>
      // Initialize DataTables
      $(document).ready(function () {
        $("#dailyRevenueTable").DataTable();
        $("#monthlyRevenueTable").DataTable();
        $("#yearlyRevenueTable").DataTable();
        $("#topSellingItemsTable").DataTable();
      });
      // Fetch and display the data (same as before)
      async function loadDashboardData() {
        try {
          const [dailyRevenue, monthlyRevenue, yearlyRevenue, topSellingItems] =
            await Promise.all([
              fetch("/api/revenue-by-day").then((res) => res.json()),
              fetch("/api/monthly-revenue").then((res) => res.json()),
              fetch("/api/yearly-revenue").then((res) => res.json()),
              fetch("/api/top-selling-items").then((res) => res.json()),
            ]);

          const dailyTableBody = document.getElementById(
            "dailyRevenueTableBody"
          );
          const monthlyTableBody = document.getElementById(
            "monthlyRevenueTableBody"
          );
          const yearlyTableBody = document.getElementById(
            "yearlyRevenueTableBody"
          );
          const topItemsTableBody = document.getElementById(
            "topSellingItemsTableBody"
          );

          // Populate the Daily Revenue Table
          dailyRevenue.forEach((dayData) => {
            const row = document.createElement("tr");

            // Assuming dayData.day is something like "2024-09-01" (YYYY-MM-DD)
            const dayCell = document.createElement("td");
            const date = new Date(dayData.day);

            if (!isNaN(date.getTime())) {
              // Check if the date is valid
              // Format date as desired, e.g., "September 1, 2024"
              const formattedDate = date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              });
              dayCell.textContent = formattedDate;
            } else {
              // Handle invalid date
              dayCell.textContent = "Invalid Date";
            }

            row.appendChild(dayCell);

            const revenueDayCell = document.createElement("td");
            revenueDayCell.textContent = `₱${dayData.totalRevenue.toFixed(2)}`;
            row.appendChild(revenueDayCell);

            const actionCell = document.createElement("td");
            actionCell.innerHTML = `
                <button class="btn btn-sm btn-info" onclick="downloadRowCSV('daily', '${
                  dayData.day
                }', '${dayData.totalRevenue.toFixed(2)}')">CSV</button>
                <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('daily', '${
                  dayData.day
                }', '${dayData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            dailyTableBody.appendChild(row);
          });

          // Populate the Monthly Revenue Table
          monthlyRevenue.forEach((monthData) => {
            const row = document.createElement("tr");

            const monthCell = document.createElement("td");
            monthCell.textContent = monthData.month;
            row.appendChild(monthCell);

            const revenueMonthCell = document.createElement("td");
            revenueMonthCell.textContent = `₱${monthData.totalRevenue.toFixed(
              2
            )}`;
            row.appendChild(revenueMonthCell);

            const actionCell = document.createElement("td");
            actionCell.innerHTML = `
              <button class="btn btn-sm btn-info" onclick="downloadRowCSV('monthly', '${
                monthData.month
              }', '${monthData.totalRevenue.toFixed(2)}')">CSV</button>
              <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('monthly', '${
                monthData.month
              }', '${monthData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            monthlyTableBody.appendChild(row);
          });

          // Populate the Yearly Revenue Table
          yearlyRevenue.forEach((yearData) => {
            const row = document.createElement("tr");

            const yearCell = document.createElement("td");
            yearCell.textContent = yearData.year;
            row.appendChild(yearCell);

            const revenueYearCell = document.createElement("td");
            revenueYearCell.textContent = `₱${yearData.totalRevenue.toFixed(
              2
            )}`;
            row.appendChild(revenueYearCell);

            const actionCell = document.createElement("td");
            actionCell.innerHTML = `
              <button class="btn btn-sm btn-info" onclick="downloadRowCSV('yearly', '${
                yearData.year
              }', '${yearData.totalRevenue.toFixed(2)}')">CSV</button>
              <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('yearly', '${
                yearData.year
              }', '${yearData.totalRevenue.toFixed(2)}')">PDF</button>
            `;
            row.appendChild(actionCell);

            yearlyTableBody.appendChild(row);
          });

          // Populate the Top-Selling Items Table
          topSellingItems.forEach((itemData) => {
            const row = document.createElement("tr");

            const itemNameCell = document.createElement("td");
            itemNameCell.textContent = itemData.name;
            row.appendChild(itemNameCell);

            const totalSalesCell = document.createElement("td");
            totalSalesCell.textContent = itemData.totalSales;
            row.appendChild(totalSalesCell);

            const actionCell = document.createElement("td");
            actionCell.innerHTML = `
              <button class="btn btn-sm btn-info" onclick="downloadRowCSV('topSelling', '${itemData.name}', '${itemData.totalSales}')">CSV</button>
              <button class="btn btn-sm btn-danger" onclick="downloadRowPDF('topSelling', '${itemData.name}', '${itemData.totalSales}')">PDF</button>
            `;
            row.appendChild(actionCell);

            topItemsTableBody.appendChild(row);
          });
        } catch (error) {
          console.error("Error loading dashboard data:", error);
        }
      }

      // Download table as CSV
      function downloadTable(tableId) {
        const table = document.getElementById(tableId);
        let csvContent = "data:text/csv;charset=utf-8,";
        const rows = table.querySelectorAll("tr");

        rows.forEach((row) => {
          const cols = row.querySelectorAll("td, th");
          const rowData = Array.from(cols)
            .map((col) => col.textContent.trim())
            .join(",");
          csvContent += rowData + "\r\n";
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `${tableId}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      // Download specific row as CSV
      function downloadRowCSV(type, label, value) {
        let csvContent = "data:text/csv;charset=utf-8,";

        if (type === "daily") {
          csvContent += "Date,Revenue\n";
          csvContent += `${label},₱${value}\n`;
        } else if (type === "monthly") {
          csvContent += "Month,Revenue\n";
          csvContent += `${label},₱${value}\n`;
        } else if (type === "yearly") {
          csvContent += "Year,Revenue\n";
          csvContent += `${label},₱${value}\n`;
        } else if (type === "topSelling") {
          csvContent += "Item Name,Total Sales\n";
          csvContent += `${label},${value}\n`;
        }

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `${type}-${label}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }

      // Function to convert an image to Base64 and use it in PDF
      function getBase64Image(url, callback) {
        const img = new Image();
        img.crossOrigin = "Anonymous";
        img.onload = function () {
          const canvas = document.createElement("canvas");
          canvas.width = img.width;
          canvas.height = img.height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0);
          const dataURL = canvas.toDataURL("image/png");
          callback(dataURL);
        };
        img.src = url;
      }

      function downloadRowPDF(type, label, value, trend) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: "mm", format: "a4" });

        // Function to add image with better quality
        function addImageToPDF() {
          const img = new Image();
          img.src = "images/maya.png";
          img.onload = function () {
            const imgWidth = 40; // Width in mm
            const imgHeight = 30; // Height in mm

            // Calculate position to right-align the image
            const pdfWidth = doc.internal.pageSize.getWidth();
            const xPosition = pdfWidth - imgWidth - 10; // 10 mm from the right edge
            const yPosition = 10; // Adjust if needed for better placement

            doc.addImage(img, "PNG", xPosition, yPosition, imgWidth, imgHeight); // Position and size
            addContent();
          };
        }

        // Function to add content after image
        function addContent() {
          // Add Title and Introduction
          doc.setFontSize(16);
          doc.text("Revenue Report", 10, 50);
          doc.setFontSize(12);
          doc.text(
            "This report provides details on the revenue for the selected item.",
            10,
            60
          );
          doc.text(
            "--------------------------------------------------",
            10,
            65
          );

          // Add Details Based on Type
          doc.setFontSize(14);
          if (type === "daily") {
            doc.text("Daily Revenue Report", 10, 75);
            doc.setFontSize(12);
            doc.text(`Date: ${label}`, 10, 85);
            doc.text(`Revenue: ₱${value}`, 10, 95);
          } else if (type === "monthly") {
            doc.text("Monthly Revenue Report", 10, 75);
            doc.setFontSize(12);
            doc.text(`Month: ${label}`, 10, 85);
            doc.text(`Revenue: ₱${value}`, 10, 95);
          } else if (type === "yearly") {
            doc.text("Yearly Revenue Report", 10, 75);
            doc.setFontSize(12);
            doc.text(`Year: ${label}`, 10, 85);
            doc.text(`Revenue: ₱${value}`, 10, 95);
          } else if (type === "topSelling") {
            doc.text("Top-Selling Item Report", 10, 75);
            doc.setFontSize(12);
            doc.text(`Item Name: ${label}`, 10, 85);
            doc.text(`Total Sales: ₱${value}`, 10, 95);
          }

          // Add Trend Analysis with improved description
          doc.setFontSize(12);
          doc.text("Trend Analysis:", 10, 105);
          let trendText;

          if (trend > 0) {
            trendText = `The revenue shows an upward trend, indicating growth compared to the previous period. This positive trend suggests an increase in demand or pricing strategies.`;
          } else if (trend < 0) {
            trendText = `The revenue indicates a downward trend, reflecting a decrease compared to the previous period. This could be due to lower demand, competitive pressures, or seasonal factors.`;
          } else {
            trendText = `The revenue remains stable, showing no significant change compared to the previous period. This stability suggests consistent performance.`;
          }

          doc.text(trendText, 10, 115, { maxWidth: 180 });

          // Add Footer
          doc.setFontSize(10);
          doc.text("Generated by Maya & Me", 10, 250);
          doc.text("Date: " + new Date().toLocaleDateString(), 10, 255);

          // Save the PDF
          doc.save(`${type}-${label}.pdf`);
        }

        // Add the image and then the rest of the content
        addImageToPDF();
      }
      // Function to download the entire table as a PDF
      function downloadPDF(tableId) {
        const table = document.getElementById(tableId);

        // Use html2pdf to convert table to PDF
        const opt = {
          margin: 1,
          filename: `${tableId}.pdf`,
          image: { type: "jpeg", quality: 0.98 },
          html2canvas: { scale: 2 },
          jsPDF: { unit: "in", format: "letter", orientation: "portrait" },
        };

        html2pdf().from(table).set(opt).save();
      }
      document.addEventListener("DOMContentLoaded", loadDashboardData);
    </script>
  </body>
</html>
