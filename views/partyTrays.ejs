<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Party Trays</title>
    <style>
      .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        padding: 20px;
      }
      .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        background-color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      .card img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .card h2 {
        font-size: 1.5rem;
        margin-bottom: 10px;
      }
      .card p {
        margin-bottom: 5px;
      }
      .price-radio-group {
        margin-top: 10px;
      }
      .price-radio-group label {
        margin-right: 10px;
      }
    </style>
  </head>
  <body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
    <h1>Party Trays</h1>
    <div class="grid-container">
      <% foodItems.forEach(item => { %>
      <div class="card">
        <img src="<%= item.imageUrl %>" alt="<%= item.name %>" />
        <h2><%= item.name %></h2>
        <p><%= item.description %></p>
        <p>Price: ₱<%= item.price.toFixed(2) %></p>
        <p>
          Dietary Preferences: <% item.dietaryRestrictions.forEach(diet => { %>
          <%= diet %> <% }); %>
        </p>
        <!-- Radio buttons for different prices -->
        <div class="price-radio-group">
          <label>
            <input
              type="radio"
              name="price<%= item.id %>"
              value="<%= item.price10_12 %>"
            />
            10-12 Pax: ₱<%= item.price.toFixed(2) %>
          </label>
          <label>
            <input
              type="radio"
              name="price<%= item.id %>"
              value="<%= item.price25_30 %>"
            />
            25-30 Pax: ₱<%= item.price25_30.toFixed(2) %>
          </label>
          <label>
            <input
              type="radio"
              name="price<%= item.id %>"
              value="<%= item.price45_50 %>"
            />
            45-50 Pax: ₱<%= item.price45_50.toFixed(2) %>
          </label>
        </div>
      </div>
      <% }); %>
    </div>
  </body>
</html>
