<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css"/>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:400,700" />
  <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet" />
  <link href="https://fonts.cdnfonts.com/css/kreon" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
      integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
  <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
  <link rel="stylesheet" href="stylesheets/admin.css" />
  <script src="https://code.jquery.com/jquery-3.5.1.js"></script>

  <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
  <style>
    thead.thead-dark th {
        background-color: #343a40;
        color: #fff;
    }
</style>
</head>

<body style="background-image: url('images/standard-bg.png');background-size: cover;background-repeat: no-repeat;">
  <div class="menu-toggle">
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
  </div>
  <div>
    <div class="menu">
      <img src="images/maya.png" alt="Maya Logo" style="width: 80%; height: auto; margin-bottom: 20px; margin-left: 20px; align-items: center; justify-content: center;">
      <a href="/adminDashboard"><i class="fa-solid fa-chart-line"></i>Dashboard</a>
      <a href="/adminUserTable"><i class="fa-solid fa-users"></i>User Table</a>
      <a href="/logs"><i class="fa-solid fa-clipboard-list"></i>Logs</a>
      <a href="/adminTransactionHistory" style="font-size: 22px;"><i class="fa-solid fa-clock-rotate-left"></i>Transaction History</a>
      <a href="/adminOrderNotifications"><i class="fa-solid fa-bell"></i>Order Notifications</a>
      <a href="/adminCreateFoodItem"><i class="fa-solid fa-plus"></i>Add Food Item</a>
      <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </div>
    
      
      <div class="side-menu">
        <a href="/adminDashboard"><i class="fa-solid fa-chart-line"></i>Dashboard</a>
      <a href="/adminUserTable"><i class="fa-solid fa-users"></i>User Table</a>
      <a href="/logs"><i class="fa-solid fa-clipboard-list"></i>Logs</a>
      <a href="/adminTransactionHistory" style="font-size: 22px;"><i class="fa-solid fa-clock-rotate-left"></i>Transaction History</a>
      <a href="/adminOrderNotifications"><i class="fa-solid fa-bell"></i>Order Notifications</a>
      <a href="/adminCreateFoodItem"><i class="fa-solid fa-plus"></i>Add Food Item</a>
      <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
      </div>
      
       <div class="main-content">
      <h1 class="admn">Logs</h1>
      <table id="logsTable" class="table table-striped" style="background-color: white;">
        <thead class="thead-dark">
          <tr>
            <th>Timestamp</th>
            <th>Action</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% logs.reverse().forEach(log => { %>
          <tr>
            <td><%= log.timestamp %></td>
            <td><%= log.action %></td>
            <td><%= log.email %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      
    </div>

    <!-- Add Bootstrap JS -->
    <script>
      $(document).ready( function () {
        $('#logsTable').DataTable();
      });
    </script>
    
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  </body>

</html>
