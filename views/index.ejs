<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="stylesheets/login.css">
</head>
<body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
  <div class="topnav">
    <div class="menu-toggle">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
    <a href="/login"><img src="images/logo.png" height="60px" width="60px"></a>
    <a href="/login"><img src="images/mayame.png" height="60px" width="190px"></a>
    <div class="menu">
      <a class="nav" href="/login">Home</a>
      <a class="nav" href="/contactUs">Contact</a>
      <a class="nav" href="/aboutUs">About</a>
      <a href="/login" class="nav" style="float:right; margin-right: 5%;">Login</a>
      <a class="nav" href="/login" style="font-size: 19px; cursor:pointer; float: right; margin:0.8% 0 0 0;"><i class="fas fa-shopping-cart fa-2x"></i> </a>
    </div>
    <div class="side-menu">
      <a href="/UserDashboard">Home</a>
      <a href="#">Contact</a>
      <a href="/aboutUs">About</a>
      <a style="color: #000000;" href="/login">My Cart</a>
      <a href="/login">Login</a>
    </div>
  </div>
  <div class="login-form">
    <div class="img">
      <img class="logo" src="images/logo.png" alt="">
      <div>
        <p class="del">We Deliver Good Food</p>
      </div>  
    </div>
    <form action="/login" method="post">
      <section class="form text-center text-lg-start">
        <div class="card">
          <div class="row g-0 d-flex align-items-center">
            <div class="col-lg-4 d-none d-lg-flex">
              <img src="images/food.jpg" id="food-img"
                class="img-fluid w-100 rounded-t-5 rounded-tr-lg-0 rounded-bl-lg-5" />
            </div>
            <div class="col-lg-8">
              <div class="card-body py-5 px-md-5">
                <div style="text-align: center; margin-top:0;">
                  <label class="lbl">LOGIN</label>
                  <!-- Forgot Password link -->
                  <a href="/forgotPassword">Forgot Password?</a>
                </div>
                <div class="error">
                  <% if (typeof errorMessage !== 'undefined') { %>
                    <p style="color: red; font-size: 20px;" id="error-msg"><%= errorMessage %></p>
                  <% } %>
    
                  <% if (typeof message !== 'undefined') { %>
                    <p style="color: rgb(0, 255, 0); font-size: 20px;" id="success-msg"><%= message %></p>
                  <% } %>
                </div>
    
                <!-- Email input -->
                <div class="form-outline mb-4">
                  <input type="email" placeholder="Enter Email . . . . ." id="email" name="email" class="formc" required />
                </div>
    
                <!-- Password input -->
                <div class="form-outline mb-4">
                  <input type="password" placeholder="Enter Password . . . . ." id="password" name="password" class="formc" required>
                  <span><span toggle="#password" id="togglePassword" class="fa-fw fa-eye far toggle-password"></span></span>
                </div>
                <script>
                  const togglePassword = document.querySelector('#togglePassword');
                  const password = document.querySelector('#password');
    
                  togglePassword.addEventListener('click', function (e) {
                    // toggle the type attribute
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    // toggle the eye slash icon
                    this.classList.toggle('fa-eye-slash');
                  });
    
                  // Function to synchronize image height with form height
                  function synchronizeImageHeight() {
                    const img = document.getElementById('food-img');
                    const formCard = img.closest('.card');
                    img.style.height = formCard.offsetHeight + 'px';
                  }
    
                  // Call the function on window load and whenever there's an error message
                  window.onload = synchronizeImageHeight;
                  if (document.getElementById('error-msg')) {
                    synchronizeImageHeight();
                  }
                </script>
                <!-- Submit button -->
                <div class="action" accesskey="">
                  <button class="btns">Login</button>
                </div>
                <div class="actionss">
                  <label class="lbll" for="">Or</label>
                </div>
                <div class="actions">
                  <a href="/auth/google" class="btn btn-primary">
                    <div class="fa-google-wrapper"><span class="fab fa-google"></span></div>&emsp14;Login with Google</i>
                  </a>
                </div>
                <div>
                  <!-- Simple link -->
                  <label class="dha">Don't Have An Account?</label> <a href="/register"> Register here!</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </form>
  </div>
  <!-- End of .container -->
  <script src="scripts/index.js"></script>
</body>
</html>
