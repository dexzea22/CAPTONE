<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="website icon" type="png" href="images/maya.png" />
        <link href="https://fonts.cdnfonts.com/css/caveat" rel="stylesheet" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Rubik:400,700" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
          integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
        <script src="https://kit.fontawesome.com/7f01a542af.js" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" />
        <link rel="stylesheet" href="stylesheets/menu.css" />
      <link rel="stylesheet" href="stylesheets/index.css">
        <title>OrderHistory</title>
      </head>
      
          
<body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
    <div class="lblso" style="margin: auto;">
       <label class="fpu">Order History</label>
    </div>

    <!-- orderHistory.ejs -->

<% const filteredOrders = orders; %> <!-- Remove any status-based filtering here to display all orders -->



    <% if (filteredOrders.length > 0) { %>
        <div class="grid-container">
            <% filteredOrders.forEach(order => { %>
                <div class="order-card">
                    <p><strong>Order ID:</strong> <%= order.id %></p>
                    <p><strong>Status:</strong> <strong style="color: red;"><%= order.status %></strong></p>
                    <p><strong>Order Date:</strong> <%= new Date(order.createdAt).toLocaleString('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric' }) %></p>
                    <p><strong>Amount:</strong> <%= order.amount %></p>
                    <p><strong>Shipping Address:</strong> <%= order.shippingAddress %></p>
                    <p><strong>Contact Person:</strong> <%= order.contactPerson %></p>
                    <p><strong>Contact Number:</strong> <%= order.contactNumber %></p>
                    <p><strong>Order Items:</strong></p>
                           
                    <div class="item-grid">
                        <% order.orderItems.forEach(item => { %>
                            <li>
                                <strong>Payment Method:</strong> <%= order.paymentMethod %><br> <!-- Display payment method -->
                                <strong>Item ID:</strong> <%= item.itemId %><br>
                                <strong>Item Name:</strong> <%= item.itemName %><br>
                                <strong>Item Size:</strong> <%= item.itemSize %><br>
                                <strong>Quantity:</strong> <%= item.quantity %><br>
                                <strong>Price:</strong> <%= item.itemPrice %><br>
                                <strong>Total Price:</strong> <%= item.totalPrice %><br>
                                <strong>Item Image:</strong> <img src="<%= item.itemImageUrl %>" alt="<%= item.itemName %>"><br>
                            </li>
                        <% }); %>
                    </ul>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No orders found.</p>
    <% } %>

    <a href="/orderStatus">Check Order Status</a>
    <!-- Add more links or buttons as needed -->
    <script>
      // Function to update the cart counter and item counter
      function updateCartCounter() {
                fetch('/api/cart/items', {
                    method: 'GET',
                    credentials: 'include', // Important for sessions
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Failed to fetch cart items. Please try again.');
                        }
                        return response.json();
                    })
                    .then(data => {
                        // Calculate total number of items in the cart
                        const totalItems = data.reduce((total, item) => total + item.quantity, 0);
                        // Update the cart counter and item counter in the UI
                        document.getElementById('cart-counter').textContent = totalItems;
                        document.getElementById('item-counter').textContent = totalItems; // Update item counter
                    })
                    .catch(error => {
                        console.error('Error fetching cart items:', error);
                        // Display an error message or handle it as per your requirement
                    });
            }
    
            // Call the function to update the cart counter and item counter when the page loads
            document.addEventListener('DOMContentLoaded', updateCartCounter);
    </script>
    <script src="scripts/meals.js"></script>

</body>

</html>
