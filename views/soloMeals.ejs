    <h1 class="ttl">Solo Meals</h1>
    <div class="grid-container">
      <% foodItems.forEach(item => { %>
        <div class="cards h-100 <% if (!item.available) { %>unavailable-card<% } %>" id="card-<%= item.name.replace(/\s+/g, '-') %>" data-dietary-restrictions="<%= item.dietaryRestrictions.join(',') %>" data-category="Solo Meals">
          <img src="<%= item.imageUrl %>" class="card-img-top" alt="<%= item.name %>">
          <% if (!item.available) { %>
              <% } %>

              <div class="card-body">
                <h5 class="card-title"><%= item.name %></h5>
                <p class="card-text">
                  <% item.dietaryRestrictions.forEach((diet, index) => { %>
                    <%= diet %><% if (index !== item.dietaryRestrictions.length - 1) { %>, <% } %>
                  <% }); %>
                </p>
                <!-- Category -->
                <p>Category: <%= item.category %></p>
                <% if (item.available) { %>
                  <!-- Quantity input -->
                  <div class="form-group">
                    <label for="quantity-<%= item.name.replace(/\s+/g, '-') %>">Quantity:</label>
                    <input type="number" class="qty quantity-input" id="quantity-<%= item.name.replace(/\s+/g, '-') %>"
                      value="1" min="1" data-price="<%= item.price %>">
                  </div>
                  <!-- Add Egg checkbox -->
                  <div class="form-group form-check">
                    <input type="checkbox" class="add-egg"
                      id="withEgg-<%= item.name.replace(/\s+/g, '-') %>" data-egg-price="5">
                    <label class="form-check-label" for="withEgg-<%= item.name.replace(/\s+/g, '-') %>">Add Egg (₱5)</label>
                  </div>
                  <!-- Total Price -->
                  <p class="card-text">Total Price: ₱<span class="total-price"><%= item.price.toFixed(2) %></span></p>
                  <!-- Add to Cart button -->
                  <button type="button" class="cbtn"
                    onclick="addToCart('card-<%= item.name.replace(/\s+/g, '-') %>')"><i class="fas fa-shopping-cart"></i></button>
                <% } else { %>
                  <div class="unavailable-text">Unavailable</div>

                <% } %>
              </div>
            </div>
        <% }); %>
    </div>
  
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
