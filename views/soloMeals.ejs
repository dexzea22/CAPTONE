    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const quantityInputs = document.querySelectorAll(".quantity-input");
        const eggCheckboxes = document.querySelectorAll(".add-egg");
  
        function updateTotalPrice(cardBody) {
          const price = parseFloat(cardBody.querySelector(".quantity-input").getAttribute("data-price"));
          const quantity = parseInt(cardBody.querySelector(".quantity-input").value);
          const eggPrice = cardBody.querySelector(".add-egg").checked ? parseFloat(cardBody.querySelector(".add-egg").getAttribute("data-egg-price")) : 0;
          const totalPriceElement = cardBody.querySelector(".total-price");
          const newTotalPrice = (price * quantity + eggPrice * quantity).toFixed(2);
          totalPriceElement.textContent = newTotalPrice;
        }
  
        quantityInputs.forEach(input => {
          input.addEventListener("input", function () {
            const cardBody = this.closest(".card-body");
            updateTotalPrice(cardBody);
          });
        });
  
        eggCheckboxes.forEach(checkbox => {
          checkbox.addEventListener("change", function () {
            const cardBody = this.closest(".card-body");
            updateTotalPrice(cardBody);
          });
        });
      });
      var modal = document.getElementById("dietaryPreferencesModal");
    var btn = document.getElementById("dietaryPreferencesNav");

    function openDietaryModal() {
      modal.style.display = "block";
    }

    window.onclick = function (event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    };

    function closeDietaryModal() {
      modal.style.display = "none";
    }
    // ...other code...

    async function handleSubmit(event) {
      event.preventDefault();
      const errorDisplay = document.getElementById("errorDisplay");

      // Reset the error display
      errorDisplay.style.display = "none";
      errorDisplay.textContent = "";

      const form = document.getElementById("dietaryForm");
      const dietaryPreferences = {
        vegetarian: form["vegetarian"].checked,
        // vegan: form["vegan"].checked,
        omnivore: form["omnivore"].checked,
        // halal: form["halal"].checked,
        // kosher: form["kosher"].checked,
        // lactoseFree: form["lactoseFree"].checked,
        glutenFree: form["glutenFree"].checked,
        nutAllergy: form["nutAllergy"].checked,
        // otherRestrictions: form["otherRestrictions"].value.trim(),
      };

      console.log("CALL 1", dietaryPreferences);

      // Check if at least one dietary choice is selected
      const isAnyChoiceSelected = Object.values(dietaryPreferences).some(
        (choice) => choice
      );
      if (!isAnyChoiceSelected) {
        errorDisplay.textContent =
          "Please select at least one dietary preference.";
        errorDisplay.style.display = "block";
        return; // Don't proceed with the submission
      }

      // Proceed with submission
      try {
        const response = await fetch("/submit-dietary-preferences", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(dietaryPreferences),
        });

        if (response.ok) {
          const contentType = response.headers.get("content-type");
          if (contentType && contentType.includes("application/json")) {
            const data = await response.json();
            if (data.success) {
              // Show the success message using SweetAlert
              Swal.fire({
                icon: "success",
                title: "Success!",
                text: "Your dietary preferences have been submitted successfully!",
                showConfirmButton: true,
              }).then(() => {
                window.location.href = "/recommendations";
              });
            } else {
              throw new Error(data.message || "An error occurred.");
            }
          } else {
            throw new Error("Received non-JSON response from server");
          }
        } else {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
      } catch (error) {
        console.error("Error:", error);
        errorDisplay.textContent = error.message;
        errorDisplay.style.display = "block";
      }
    }

    function displayRecommendations(recommendations) {
      const recommendationsContainer = document.getElementById(
        "recommendations-container"
      );
      if (recommendationsContainer) {
        recommendationsContainer.innerHTML = recommendations
          .map((rec) => `<li>${rec}</li>`)
          .join("");
      }
    }
    document.addEventListener('DOMContentLoaded', function () {
  // Add event listener for input event on the search input
  document.getElementById('menuSearchInput').addEventListener('input', function () {
    performSearch();
  });

  function performSearch() {
    // Get the value from the search input
    var searchQuery = document.getElementById('menuSearchInput').value.toLowerCase();

    // Get all cards on the page
    var cards = document.querySelectorAll('.card, .cards');

    // Perform your search logic here
    cards.forEach(function (card) {
      var cardTitle = card.querySelector('h5').innerText.toLowerCase();
      if (cardTitle.includes(searchQuery)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
});


   // Function to update the cart counter and item counter
   function updateCartCounter() {
            fetch('/api/cart/items', {
                method: 'GET',
                credentials: 'include', // Important for sessions
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Failed to fetch cart items. Please try again.');
                    }
                    return response.json();
                })
                .then(data => {
                    // Calculate total number of items in the cart
                    const totalItems = data.reduce((total, item) => total + item.quantity, 0);
                    // Update the cart counter and item counter in the UI
                    document.getElementById('cart-counter').textContent = totalItems;
                    document.getElementById('item-counter').textContent = totalItems; // Update item counter
                })
                .catch(error => {
                    console.error('Error fetching cart items:', error);
                    // Display an error message or handle it as per your requirement
                });
        }

        // Call the function to update the cart counter and item counter when the page loads
        document.addEventListener('DOMContentLoaded', updateCartCounter);
    </script>
  
  
  
    
