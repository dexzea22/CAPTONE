<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solo Meals</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      .card img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .unavailable-card {
        opacity: 0.5; /* Adjust opacity for grayed-out effect */
        position: relative;
      }
      .unavailable-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 1.2rem;
        font-weight: bold;
        color: red; /* Example color for unavailable text */
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1 class="my-4">Solo Meals</h1>
      <div class="row">
        <% foodItems.forEach(item => { %>
        <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
          <div
            class="card h-100 <% if (!item.available) { %>unavailable-card<% } %>"
          >
            <% if (!item.available) { %>
            <div class="unavailable-text">Unavailable</div>
            <% } %>
            <img
              src="<%= item.imageUrl %>"
              class="card-img-top"
              alt="<%= item.name %>"
            />

            <div class="card-body">
              <h5 class="card-title"><%= item.name %></h5>
              <p class="card-text"><%= item.description %></p>
              <p class="card-text">
                Price: $<span class="item-price"
                  ><%= item.price.toFixed(2) %></span
                >
              </p>
              <p class="card-text">
                Dietary Preferences: <% item.dietaryRestrictions.forEach(diet =>
                { %> <%= diet %><% if (diet !==
                item.dietaryRestrictions[item.dietaryRestrictions.length - 1]) {
                %>, <% } %> <% }); %>
              </p>
              <% if (item.available) { %>
              <div class="form-group">
                <label for="quantity-<%= item.id %>">Quantity:</label>
                <input
                  type="number"
                  class="form-control quantity-input"
                  id="quantity-<%= item.id %>"
                  value="1"
                  min="1"
                  data-price="<%= item.price %>"
                />
              </div>
              <div class="form-group form-check">
                <input
                  type="checkbox"
                  class="form-check-input add-egg"
                  id="add-egg-<%= item.id %>"
                  data-egg-price="5"
                />
                <label class="form-check-label" for="add-egg-<%= item.id %>"
                  >Add Egg ($5)</label
                >
              </div>
              <p class="card-text">
                Total Price: $<span class="total-price"
                  ><%= item.price.toFixed(2) %></span
                >
              </p>
              <!-- Add to Cart button -->
              <button class="btn btn-primary mt-3">Add to Cart</button>
              <% } else { %>
              <p class="card-text text-center text-muted">Unavailable</p>
              <% } %>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const quantityInputs = document.querySelectorAll(".quantity-input");
        const eggCheckboxes = document.querySelectorAll(".add-egg");

        function updateTotalPrice(cardBody) {
          const price = parseFloat(
            cardBody.querySelector(".quantity-input").getAttribute("data-price")
          );
          const quantity = parseInt(
            cardBody.querySelector(".quantity-input").value
          );
          const eggPrice = cardBody.querySelector(".add-egg").checked
            ? parseFloat(
                cardBody
                  .querySelector(".add-egg")
                  .getAttribute("data-egg-price")
              )
            : 0;
          const totalPriceElement = cardBody.querySelector(".total-price");
          const newTotalPrice = (
            price * quantity +
            eggPrice * quantity
          ).toFixed(2);
          totalPriceElement.textContent = newTotalPrice;
        }

        quantityInputs.forEach((input) => {
          input.addEventListener("input", function () {
            const cardBody = this.closest(".card-body");
            updateTotalPrice(cardBody);
          });
        });

        eggCheckboxes.forEach((checkbox) => {
          checkbox.addEventListener("change", function () {
            const cardBody = this.closest(".card-body");
            updateTotalPrice(cardBody);
          });
        });
      });
    </script>
  </body>
</html>
