<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Solo Meals</title>
    <link rel="website icon" type="png" href="images/maya.png">
   <link rel="stylesheet" href="stylesheets/solo.css">
  </head>
  <body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;"></body>
  <h1>Solo Mealssss</h1>
    <div class="grid-container">
      <% foodItems.forEach(item => { %>
      <div class="card">
        <img src="<%= item.imageUrl %>" alt="<%= item.name %>" />
        <h2><%= item.name %></h2>
        <p><%= item.description %></p>
        <p>Price: ₱<%= item.price.toFixed(2) %></p>
        <p>
          Dietary Preferences: <% item.dietaryRestrictions.forEach(diet => { %>
          <%= diet %> <% }); %>
        </p>
      </div>
      <% }); %>
    </div>
  </body>
</html>
