    </nav>

    <!-- Mobile Navbar -->
    <nav class="navbar navbar-expand-md navbar-dark bg-dark d-md-none">
        <a class="navbar-brand" href="#">Admin Dashboard</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/adminDashboard"><i class="fas fa-chart-line"></i> Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/adminUserTable"><i class="fas fa-users"></i> User Table</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logs"><i class="fas fa-clipboard-list"></i> Logs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/adminTransactionHistory"><i class="fas fa-clock-rotate-left"></i> Transaction History</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/adminOrderNotifications"><i class="fas fa-bell"></i> Order Notifications</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/adminCreateFoodItem"><i class="fas fa-plus"></i> Add Food Item</a>
