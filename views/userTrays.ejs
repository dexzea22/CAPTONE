    <div class="dashboard-content" id="container">
      <div class="cards" id="afrtd">
        <img class="card-image" src="images/afritada.jpg" alt="" />
        <div class="card-detail">
          <h4>Afritada (Tray)</h4>
          <div class="gallery" style="margin-top: 11%">
            <label>
              <img src="images/sTray.png" alt="Image 1" /><br />
              <input type="radio" name="size" value="(10 to 12 pax)-570" onchange="updatePriceDisplay('afrtd')" />
              S (₱570) (10-12 pax)
            </label>
            <label>
              <img src="images/mTray.png" alt="Image 2" /><br />
              <input type="radio" name="size" value="(25 to 30 pax)-1350" onchange="updatePriceDisplay('afrtd')" />
              M (₱1,350) (25-30 pax)
            </label>
            <label>
              <img src="images/lTray.png" alt="Image 3" /><br />
              <input type="radio" name="size" value="(45 to 50 pax)-2600" onchange="updatePriceDisplay('afrtd')" />
              L (₱2,600) (45-50 pax)
            </label>
          </div>
          <!-- Lightbox (hidden by default) -->
          <div class="lightbox" id="lightbox">
            <img src="" alt="Enlarged Image" class="lightbox-image" />
          </div>
          <div class="quantity-selector">
            <label>Quantity:</label>
            <button onclick="changeQuantity('afrtd', -1)">-</button>
            <input type="text" id="quantity-afrtd" value="1" style="width: 40px; text-align: center;" onchange="updatePriceDisplay('afrtd')">
            <button onclick="changeQuantity('afrtd', 1)">+</button>
          </div>
          <div>Total Price: ₱<span id="total-price-afrtd">0.00</span></div>
          <div class="rat">
            <p>Rating:</p>
            <div class="star-rating" id="star-rating5">
              <!-- Star icons will be added here using JavaScript -->
            </div>
          </div>
          <p class="card-time"><span class="fas fa-clock"></span>15-30 mins</p>
          
          <button onclick="addToCart('Pork Afritada','afrtd')" class="cbtn">
            <i class="fas fa-shopping-cart"></i>
          </button>
        </div>
      </div>
