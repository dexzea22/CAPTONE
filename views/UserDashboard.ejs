<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css"/>
<link rel="stylesheet" href="stylesheets/user.css">
<link rel="stylesheet" href="stylesheets/index.css">
<style>
  .card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        background-color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        width: auto;
      }
      .card img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 10px;
      }
      .card h2 {
        font-size: 1.5rem;
        margin-bottom: 10px;
      }
      .card p {
        margin-bottom: 5px;
      }
      .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
        padding: 20px;
      }
      /* CSS for unavailable cards */
      .card.unavailable {
        opacity: 0.5; /* Adjust opacity to make it look grayed-out */
        pointer-events: none; /* Disable pointer events so the card cannot be interacted with */
      }

      .unavailable-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 100%;
      }

      .unavailable-text p {
        color: red; /* Red text color for the "Unavailable" message */
        font-size: 1.5rem; /* Adjust font size as needed */
        font-weight: bold; /* Optionally, make the text bold */
      }
</style>
</head>

<body style="background-image: url('images/standard-bg.png'); background-size: cover;background-repeat: no-repeat;">
  
<!-- Features Section -->
<div class="container">
  
<div class="lbls">
<label class="fpu" for="">Featured Products</label>
</div>
<!-- End Jumbotron -->
<!-- featuredItem.ejs -->

<!-- featuredItem.ejs -->

<!-- featuredItem.ejs -->

<section class="feature-food">
  <div class="grid-container">
    <% foodItems.forEach(item => { %>
      <div class="card h-100 <%= item.category === 'Solo Meals' ? 'solo-meal' : 'party-tray' %> <%= !item.available ? 'unavailable' : '' %>" id="card-<%= item.name.replace(/\s+/g, '-') %>" data-item-id="<%= item.id %>" data-category="<%= item.category %>" data-dietary-restrictions="<%= item.dietaryRestrictions.join(',') %>">
        <img src="<%= item.imageUrl %>" class="card-img-top" alt="<%= item.name %>">
        <div class="card-body">
          <h5 class="card-title"><%= item.name %></h5>
          <p class="card-text">
            <% item.dietaryRestrictions.forEach((diet, index) => { %>
              <%= diet %><% if (index !== item.dietaryRestrictions.length - 1) { %>, <% } %>
            <% }); %>
          </p>
          <p class="card-text">Category: <%= item.category %></p>
          
          <% if (item.category === 'Solo Meals') { %>
            <div class="solo-meal" data-item-id="<%= item.id %>">
              <!-- Quantity input -->
              <div class="form-group">
                <label for="quantity-<%= item.name.replace(/\s+/g, '-') %>">Quantity:</label>
                <input type="number" class="form-control quantity-input" id="quantity-<%= item.name.replace(/\s+/g, '-') %>" value="1" min="1" data-price="<%= item.price %>">
              </div>
              <div class="form-check">
                <input type="checkbox" class="form-check-input add-egg" id="withEgg-<%= item.id %>" data-egg-price="5"> with Egg (₱5.00)<br>
              </div>
              <div class="form-group">
                <label>Total Price:</label>
                <span class="total-price">₱<%= item.price.toFixed(2) %></span>
              </div>
              <button class="btn btn-primary mt-3" onclick="addToCart('card-<%= item.name.replace(/\s+/g, '-') %>')">Add to Cart</button>
            </div>
          
          <% } else if (item.category === 'Party Trays') { %>
            <div class="party-tray" data-item-id="<%= item.id %>">
              <!-- Radio buttons for different sizes and prices -->
              <div class="price-radio-group">
                <div class="form-check">
                  <input type="radio" class="form-check-input price-radio" name="price<%= item.id %>" value="<%= item.price %>" id="price<%= item.id %>-10-12" data-price="<%= item.price %>" checked <%= !item.available ? 'disabled' : '' %>>
                  <label class="form-check-label" for="price<%= item.id %>-10-12">
                    <img src="/images/sTray.png" alt="10-12 Pax" /> Small 10-12 Pax: ₱<%= item.price.toFixed(2) %>
                  </label>
                </div>
                <div class="form-check">
                  <input type="radio" class="form-check-input price-radio" name="price<%= item.id %>" value="<%= item.price25_30 %>" id="price<%= item.id %>-25-30" data-price="<%= item.price25_30 %>" <%= !item.available ? 'disabled' : '' %>>
                  <label class="form-check-label" for="price<%= item.id %>-25-30">
                    <img src="/images/mTray.png" alt="25-30 Pax" /> Medium 25-30 Pax: ₱<%= item.price25_30.toFixed(2) %>
                  </label>
                </div>
                <div class="form-check">
                  <input type="radio" class="form-check-input price-radio" name="price<%= item.id %>" value="<%= item.price45_50 %>" id="price<%= item.id %>-45-50" data-price="<%= item.price45_50 %>" <%= !item.available ? 'disabled' : '' %>>
                  <label class="form-check-label" for="price<%= item.id %>-45-50">
                    <img src="/images/lTray.png" alt="45-50 Pax" /> Large 45-50 Pax: ₱<%= item.price45_50.toFixed(2) %>
                  </label>
                </div>
              </div>
              <!-- Quantity selector -->
              <div class="form-group mt-3">
                <label for="quantity-<%= item.name.replace(/\s+/g, '-') %>">Quantity:</label>
                <input type="number" class="form-control quantity-input" id="quantity-<%= item.name.replace(/\s+/g, '-') %>" value="1" min="1" data-price="<%= item.price %>" onchange="updateTotalPrice('card-<%= item.name.replace(/\s+/g, '-') %>')" <%= !item.available ? 'disabled' : '' %>>
              </div>
              <!-- Total price display -->
              <div class="form-group">
                <label>Total Price:</label>
                <span id="totalPrice-<%= item.id %>">₱<%= item.price.toFixed(2) %></span>
              </div>
              <!-- Add to Cart button -->
              <button class="btn btn-primary mt-3" onclick="addToCart('card-<%= item.name.replace(/\s+/g, '-') %>')">Add to Cart</button>
            </div>
          <% } %>
          
          <% if (!item.available) { %>
            <div class="card-overlay"></div>
            <div class="unavailable-text">
              <p>Unavailable</p>
            </div>
          <% } %>
          
        </div>
      </div>
    <% }); %>
  </div>
</section>
 <!-- Bootstrap JS and dependencies -->
 <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
 <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
 <!-- Your meals.js script -->
 <script src="scripts/meals.js"></script>
 <!-- SweetAlert2 JS -->
 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
 document.addEventListener("DOMContentLoaded", function () {
  const cards = document.querySelectorAll('.card');

  function updateTotalPrice(cardBody) {
    const isSoloMeal = cardBody.classList.contains('solo-meal');
    const quantityInput = cardBody.querySelector(".quantity-input");
    const quantity = parseInt(quantityInput.value);
    let newTotalPrice = 0;

    if (isSoloMeal) {
      const price = parseFloat(quantityInput.getAttribute("data-price"));
      const addEggCheckbox = cardBody.querySelector(".add-egg");
      const addEggPrice = addEggCheckbox.checked ? parseFloat(addEggCheckbox.getAttribute("data-egg-price")) : 0;
      newTotalPrice = ((price + addEggPrice) * quantity).toFixed(2);
      const totalPriceElement = cardBody.querySelector(".total-price");
      totalPriceElement.textContent = "₱" + newTotalPrice;
    } else {
      const selectedRadio = cardBody.querySelector(`input[name="price${cardBody.dataset.itemId}"]:checked`);
      if (!selectedRadio) return;
      const radioPrice = parseFloat(selectedRadio.getAttribute("data-price"));
      newTotalPrice = (radioPrice * quantity).toFixed(2);
      const totalPriceElement = cardBody.querySelector(`#totalPrice-${cardBody.dataset.itemId}`);
      totalPriceElement.textContent = "₱" + newTotalPrice;
    }
  }

  cards.forEach(cardBody => {
    const quantityInput = cardBody.querySelector(".quantity-input");
    if (quantityInput) {
      quantityInput.addEventListener("input", function () {
        updateTotalPrice(cardBody);
      });
    }

    if (cardBody.classList.contains('solo-meal')) {
      const addEggCheckbox = cardBody.querySelector(".add-egg");
      if (addEggCheckbox) {
        addEggCheckbox.addEventListener("change", function () {
          updateTotalPrice(cardBody);
        });
      }
    } else if (cardBody.classList.contains('party-tray')) {
      const priceRadios = cardBody.querySelectorAll(".price-radio");
      priceRadios.forEach(radio => {
        radio.addEventListener("change", function () {
          updateTotalPrice(cardBody);
        });
      });
    }
  });
});

</script>









</body>
</html>
