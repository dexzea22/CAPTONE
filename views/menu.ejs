  <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Function to update total price based on item type
        function updateTotalPrice(itemId) {
            const quantityInput = document.getElementById('quantity-' + itemId);
            const eggCheckbox = document.getElementById('withEgg-' + itemId);
            const totalPriceSpan = document.getElementById('totalPrice-' + itemId);

            // Determine if item is a party tray or solo meal
            const priceRadios = document.querySelectorAll(`input[name="price${itemId}"]`);
            const selectedPriceRadio = Array.from(priceRadios).find(radio => radio.checked);
            const basePrice = selectedPriceRadio ? parseFloat(selectedPriceRadio.getAttribute('data-price')) : parseFloat(quantityInput.getAttribute('data-price'));
            let totalPrice = basePrice * quantityInput.value;

            // Add egg price if checkbox is checked
            if (eggCheckbox && eggCheckbox.checked) {
                totalPrice += parseFloat(eggCheckbox.getAttribute('data-egg-price')) * quantityInput.value;
            }

            totalPriceSpan.textContent = '₱' + totalPrice.toFixed(2);
        }

        // Add event listeners to quantity inputs and egg checkboxes
        document.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('change', function() {
                const itemId = this.id.replace('quantity-', '');
                updateTotalPrice(itemId);
            });
        });

        document.querySelectorAll('.add-egg').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const itemId = this.id.replace('withEgg-', '');
                updateTotalPrice(itemId);
            });
        });

        // Add event listener to price radio buttons
        document.querySelectorAll('.price-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                const itemId = this.name.replace('price', '');
                updateTotalPrice(itemId);
            });
        });
    });
</script>

