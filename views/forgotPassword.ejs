<!-- forgotPassword.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="/stylesheets/login.css">
</head>
<body>
  <div class="login-form">
    <div class="img">
      <img class="logo" src="images/logo.png" alt="">
      <div>
        <p class="del">We Deliver Good Food</p>
      </div>  
    </div>
    <form action="/forgotPassword" method="post">
      <section class="form text-center text-lg-start">
        <div class="card">
          <div class="card-body py-5 px-md-5">
            <div style="text-align: center; margin-top:0;">
              <label class="lbl">Forgot Password</label>
            </div>
            <div class="error">
              <% if (typeof errorMessage !== 'undefined') { %>
                <p style="color: red; font-size: 20px;" id="error-msg"><%= errorMessage %></p>
              <% } %>

              <% if (typeof successMessage !== 'undefined') { %>
                <p style="color: green; font-size: 20px;" id="success-msg"><%= successMessage %></p>
              <% } %>
            </div>

            <!-- Email input -->
            <div class="form-outline mb-4">
              <input type="email" placeholder="Enter your email" id="email" name="email" class="formc" required />
            </div>

            <!-- Submit button -->
            <div class="action" accesskey="">
              <button class="btns">Reset Password</button>
            </div>

            <div>
              <!-- Simple link -->
              <a href="/login">Return to Login</a>
            </div>
          </div>
        </div>
      </section>
    </form>
  </div>
</body>
</html>
