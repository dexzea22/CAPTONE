    <div class="login-form">
      <form action="/register" method="post" name="register">
        <div class="container">
          <div class="row d-flex justify-content-center align-items-center">
            <div class="col">
              <div class="card card-registration my-4">
                <div class="row g-0">
                  <div class="col-xl-6 d-none d-xl-block">
                    <img
                      src="images/reg.jpg"
                      alt="Sample photo"
                      class="img-fluid"
                      style="
                        border-top-left-radius: 0.25rem;
                        border-bottom-left-radius: 0.25rem;
                      "
                    />
                  </div>
                  <div class="col-xl-6">
                    <div class="card-body p-md-5 text-black">
                      <h3 class="mb-5 text-uppercase">
                        <label class="reg" for="register now">
                        Register Now!
                      </label>
                      </h3>
                      <div class="error">
                        <% if (typeof errorMessage !== 'undefined') { %>
                        <p style="color: red"><%= errorMessage %></p>
                        <% } %>
                      </div>

                      <!-- First Name / Last Name -->
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="form-outline">
      <input
        type="text"
        id="firstName"
        name="firstName"
        placeholder="Firstname . . ."
        class="form-control form-control-lg"
        value="<%= data.firstName ? data.firstName : '' %>"
      />
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="form-outline">
      <input
        type="text"
        id="lastName"
        name="lastName"
        placeholder="Lastname . . ."
        class="form-control form-control-lg"
        value="<%= data.lastName ? data.lastName : '' %>"
      />
    </div>
  </div>
</div>

<!-- Email -->
<div class="row">
  <div class="col-md-12 mb-3">
    <div class="form-outline">
      <input
        type="email"
        id="email"
        name="email"
        placeholder="Email Address . . ."
        class="form-control form-control-lg"
        required
        value="<%= data.email ? data.email : '' %>"
      />
    </div>
  </div>
</div>

<!-- Password fields don't retain value for security reasons -->
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="form-outline position-relative">
      <div class="input-group">
        <input style="font-size: 15px" type="password" id="password" name="password" placeholder="Password . . ." class="form-control form-control-lg" />
        <span>
            <span id="togglePassword" class="fa-fw fa-eye far toggle-password"></span>
        </span>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="form-outline">
      <div class="input-group">
        <input style="font-size: 15px" type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password . . ." class="form-control form-control-lg" />
        <span>
            <span id="toggleCpassword" class="fa-fw fa-eye far toggle-password"></span>
        </span>
      </div>
    </div>
  </div>
</div>

<!-- Gender -->
<div class="d-md-flex justify-content-start align-items-center mb-4 py-2">
  <h6 style="color: #c69b68" class="mb-0 me-3">
    Gender: &emsp;
  </h6>
  <!-- Add checked attribute based on provided data -->
  <div class="form-check form-check-inline mb-0 me-3">
    <input
      class="form-check-input"
      type="radio"
      name="gender"
      id="femaleGender"
      value="Female"
      <%= data.gender === 'Female' ? 'checked' : '' %>
    />
    <label class="form-check-label" for="femaleGender">Female</label>
  </div>
  <div class="form-check form-check-inline mb-0 me-3">
    <input
      class="form-check-input"
      type="radio"
      name="gender"
      id="maleGender"
      value="Male"
      <%= data.gender === 'Male' ? 'checked' : '' %>
    />
    <label class="form-check-label" for="maleGender">Male</label>
  </div>
  <div class="form-check form-check-inline mb-0">
    <input
      class="form-check-input"
      type="radio"
      name="gender"
      id="otherGender"
      value="Other"
      <%= data.gender === 'Other' ? 'checked' : '' %>
    />
    <label class="form-check-label" for="otherGender">Other</label>
  </div>
</div>

<!-- Address -->
<div class="form-outline mb-3">
  <input
    type="text"
    id="address"
    name="address"
    placeholder="Address . . ."
    class="form-control form-control-lg"
    value="<%= data.address ? data.address : '' %>"
  />
</div>

<!-- Date of Birth -->
<div class="row">
  <div class="col-md-6 mb-3 mb-4">
    <input
      type="date"
      id="dateOfBirth"
      name="dateOfBirth"
      class="date form-control form-control-lg"
      value="<%= data.dateOfBirth ? data.dateOfBirth : '' %>"
    />
  </div>
  <!-- Phone Number -->
  <div class="col-md-6 mb-3 mb-4">
    <input
      type="tel"
      id="phoneNumber"
      name="phoneNumber"
      placeholder="Phone number +63"
      class="form-control form-control-lg"
      value="<%= data.phoneNumber ? data.phoneNumber : '' %>"
    />
  </div>
</div>

<!-- User Type (hidden, so no user interaction expected) -->
<div class="input-field" hidden>
  <select name="usertype">
    <option value="User" selected>User</option>
  </select>
</div>
<div class="form-group">
  <input type="checkbox" id="terms" name="terms" required>
  <label for="terms">
    I agree to the <a href="#" data-toggle="modal" data-target="#termsModal">Terms and Conditions</a>
  </label>
</div>
                      <!-- Register Button -->
                      <div class="action d-flex justify-content-center pt-3">
                        <button class="btn btns btn-lg ms-2">Register</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
