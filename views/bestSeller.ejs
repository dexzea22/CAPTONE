    <script>
      // Function to open the lightbox and display the clicked image
function openLightbox(imageSrc) {
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = lightbox.querySelector('.lightbox-image');
    
    // Update the source of the lightbox image
    lightboxImage.src = imageSrc;
    
    // Show the lightbox
    lightbox.style.display = 'flex'; // Assuming the lightbox has a flex display
    
    // Add an event listener to close the lightbox when clicked
    lightbox.addEventListener('click', closeLightbox);
}

// Function to close the lightbox
function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    lightbox.style.display = 'none'; // Hide the lightbox
}

// Function to initialize the lightbox
function initializeLightbox() {
    // Get the lightbox element
    const lightbox = document.getElementById('lightbox');
    
    // Prevent clicks inside the lightbox from closing it
    lightbox.addEventListener('click', function(event) {
        event.stopPropagation();
    });
}

// Call the initializeLightbox function when the DOM is loaded
document.addEventListener('DOMContentLoaded', initializeLightbox);

      function updatePriceDisplay(cardId) {
         const selectedSize = document.querySelector(`#${cardId} input[name="size"]:checked`);
         const quantityInput = document.getElementById('quantity-' + cardId);
         const totalPriceElement = document.getElementById('total-price-' + cardId);
     
         if (selectedSize && quantityInput && totalPriceElement) {
             const [size, price] = selectedSize.value.split('-');
             const quantity = parseInt(quantityInput.value) || 0;
             const total = parseFloat(price) * quantity;
             totalPriceElement.textContent = total.toFixed(2);
         }
     }
     
     function changeQuantity(cardId, delta) {
         var input = document.getElementById('quantity-' + cardId);
         var currentValue = parseInt(input.value) || 0;
         currentValue += delta;
         if (currentValue < 1) currentValue = 1; // Prevent negative quantities
         input.value = currentValue;
         updatePriceDisplay(cardId); // Update the total price whenever the quantity changes
     }
         // Get the cards initially
         var cards = document.querySelectorAll('.cards');
     
        
           // Example function to read selected size and price
           function getSelectedSizeAndPrice(cardId) {
           const selected = document.querySelector(`#${cardId} input[name="size"]:checked`);
           if (selected) {
             const [size, price] = selected.value.split('-');
             console.log(`Selected size: ${size}, Price: ${price}`);
             // Now you can use size and price for further operations
           } else {
             console.log('No size selected');
           }
         }
          // Function to update the quantity of a cart item
          function updateCartItemQuantity(cartItemId, newQuantity) {
         fetch('/api/cart/items', {
             method: 'GET',
             credentials: 'include', // Important for sessions
         })
         .then(response => {
             if (!response.ok) {
                 throw new Error('Failed to fetch cart items. Please try again.');
             }
             return response.json();
         })
         .then(data => {
             const totalPrice = data.reduce((total, item) => total + (item.foodItem.price * item.quantity), 0);
             const itemToUpdate = data.find(item => item._id === cartItemId || item.id === cartItemId);
             const updatedTotalPrice = itemToUpdate.foodItem.price * newQuantity;
     
             // Check if adding the updated item exceeds the limit
             if (totalPrice + updatedTotalPrice > 10000) {
                 Swal.fire({
                     icon: 'warning',
                     title: 'Cart Limit Exceeded',
                     text: 'Adding this item will exceed PHP 10,000. Please remove some items.',
                 });
             } else {
                 // Proceed with updating the item quantity in the cart
                 fetch('/api/cart/updateQuantity', {
                     method: 'PUT',
                     headers: { 'Content-Type': 'application/json' },
                     credentials: 'include', // Important for sessions
                     body: JSON.stringify({ cartItemId, quantity: newQuantity }),
                 })
                 .then(response => {
                     if (!response.ok) {
                         throw new Error('Failed to update item quantity in cart. Please try again.');
                     }
                     return response.json();
                 })
                 .then(data => {
                     if (data.success) {
                         // Call the function to fetch and display cart items again
                         displayCartItems();
                     } else {
                         Swal.fire({
                             icon: 'error',
                             title: 'Error',
                             text: data.message || 'Could not update item quantity in the cart.',
                         });
                     }
                 })
                 .catch(error => {
                     console.error('Error updating item quantity in cart:', error);
                     Swal.fire({
                         icon: 'error',
                         title: 'Error',
                         text: error.message || 'An unexpected error occurred while updating item quantity in the cart.',
                     });
                 });
             }
         })
         .catch(error => {
             console.error('Error fetching cart items:', error);
             Swal.fire({
                 icon: 'error',
                 title: 'Error',
                 text: 'Failed to fetch cart items. Please try again.',
             });
         });
     }
     
     
            // Function to fetch and display cart items
     function displayCartItems() {
         fetch('/api/cart/items', {
             method: 'GET',
             credentials: 'include', // Important for sessions
         })
             .then(response => {
                 if (!response.ok) {
                     throw new Error('Failed to fetch cart items. Please try again.');
                 }
                 return response.json();
             })
             .then(data => {
                 const cartItemsContainer = document.getElementById('mod-cart-items');
                 cartItemsContainer.innerHTML = ''; // Clear previous content
     
                 if (data.length > 0) { // Check if data is not empty
                     let totalPrice = 0; // Initialize total price variable
     
                     data.forEach(item => {
                         const itemElement = document.createElement('div');
                         itemElement.classList.add('row', 'border-top', 'border-bottom');
     
                         // Calculate the total price for each item
                         const itemTotalPrice = item.foodItem.price * item.quantity;
                         totalPrice += itemTotalPrice; // Add to the total price
     
                         itemElement.innerHTML = `
                 <div class="col-2"><img class="img-fluid" src="${item.foodItem.imageUrl}" alt=""></div>
                 <div>
                     <div>${item.foodItem.name} (${item.foodItem.size})</div>
                     <div>Price: PHP ${item.foodItem.price.toFixed(2)}</div>
                     <div>Quantity: 
                         <button class="btn-quantity" data-action="decrease" onclick="updateQuantity('${item._id || item.id}', ${item.quantity - 1})">-</button>
                         <span>${item.quantity}</span>
                         <button class="btn-quantity" data-action="increase" onclick="updateQuantity('${item._id || item.id}', ${item.quantity + 1})">+</button>
     
                     </div>
                     <div>Total Price: PHP ${itemTotalPrice.toFixed(2)}</div> <!-- Display total price for each item -->
                     <button class="btn-delete" onclick="deleteCartItem('${item._id || item.id}')">Delete</button>
                 </div>
             `;
     
                         cartItemsContainer.appendChild(itemElement);
                     });
     
                     // Update the total price displayed in the UI
                     document.getElementById('total-amount').textContent = totalPrice.toFixed(2);
                     document.getElementById('total-amounthidden').textContent = totalPrice.toFixed(2);
     
                     // Check if the total price exceeds the limit
                     if (totalPrice > 10000) {
                         // Display a warning message
                         Swal.fire({
                             icon: 'warning',
                             title: 'Cart Limit Exceeded',
                             text: 'Your cart total has exceeded PHP 10,000. Please remove some items.',
                         });
                     }
                 } else {
                     // Display a message if the cart is empty
                     cartItemsContainer.innerHTML = '<div>No items in cart</div>';
                 }
             })
             .catch(error => {
                 console.error('Error fetching cart items:', error);
                 // Display an error message
                 const cartItemsContainer = document.getElementById('mod-cart-items');
                 cartItemsContainer.innerHTML = '<div>Error fetching cart items. Please try again later.</div>';
             });
     }
     
     
     
             // Call the function to fetch and display cart items when the page loads
             document.addEventListener('DOMContentLoaded', displayCartItems);
     
             document.addEventListener('DOMContentLoaded', (event) => {
                 // Get the modal
                 var modal = document.getElementById("payment-modal");
     
                 // Get the button that opens the modal
                 var btn = document.getElementById("checkoutButton");
     
                 // Get the <span> element that closes the modal
                 var span = document.getElementsByClassName("close-button")[0];
     
                 if (btn && modal && span) {
                     // When the user clicks the button, open the modal 
                     btn.onclick = function (event) {
                         event.preventDefault();  // Prevent any default button action
                         modal.style.display = "block";
                     }
     
                     // When the user clicks on <span> (x), close the modal
                     span.onclick = function (event) {
                         event.preventDefault();  // Prevent any default span action
                         modal.style.display = "none";
                     };
     
                     // When the user clicks anywhere outside of the modal, close it
                     window.onclick = function (event) {
                         if (event.target == modal) {
                             event.preventDefault();  // Prevent any default window action
                             modal.style.display = "none";
                         }
                     }
     
                     // Prevent events inside the modal from closing it and stop propagation
                     modal.children[0].onclick = function (event) {
                         event.stopPropagation();
                         event.preventDefault();  // Prevent any default action inside the modal
                     }
                 } else {
                     console.error("Elements not found. Please check the IDs and class names.");
                 }
             });
     
             function updateQuantity(cartItemId, newQuantity) {
                     // Ensure the quantity is not negative
                     if (newQuantity < 0) {
                         return;
                     }
                     updateCartItemQuantity(cartItemId, newQuantity);
                 }
             function updateCartCounter() {
                     fetch('/api/cart/items', {
                         method: 'GET',
                         credentials: 'include', // Important for sessions
                     })
                         .then(response => {
                             if (!response.ok) {
                                 throw new Error('Failed to fetch cart items. Please try again.');
                             }
                             return response.json();
                         })
                         .then(data => {
                             // Calculate total number of items in the cart
                             const totalItems = data.reduce((total, item) => total + item.quantity, 0);
                             // Update the cart counter and item counter in the UI
                             document.getElementById('cart-counter').textContent = totalItems;
                             document.getElementById('item-counter').textContent = totalItems; // Update item counter
                         })
                         .catch(error => {
                             console.error('Error fetching cart items:', error);
                             // Display an error message or handle it as per your requirement
                         });
                 }
         
                 // Call the function to update the cart counter and item counter when the page loads
                 document.addEventListener('DOMContentLoaded', updateCartCounter);
     
     
     
             
            
     
     </script>
